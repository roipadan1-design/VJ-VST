{
  "schemaVersion": "2.0",
  "id": "pulse-halo",
  "name": "Pulse Halo",
  "description": "One luminous ring with controlled bass accents, slight breathing and a dark field. Original proposed preset; requires the v2 engine contract.",
  "author": "Project starter example",
  "license": "Original example for this project; no third-party shader code included.",
  "engine": {
    "minimumVersion": "2.0.0",
    "shaderProfile": "isf-legacy",
    "workingColorSpace": "linear-srgb",
    "featureContract": "2.0"
  },
  "sourcePolicy": {
    "bass": "kick-or-mix",
    "mid": "snare-or-mix",
    "high": "hat-or-mix",
    "level": "mix"
  },
  "stages": [
    {
      "id": "halo",
      "kind": "generator",
      "shader": "shaders/pulse_halo.fs",
      "targetFormat": "rgba16f",
      "scale": 1,
      "inputs": {},
      "parameters": [
        {
          "name": "radius",
          "label": "Radius",
          "min": 0.1,
          "max": 0.9,
          "default": 0.45,
          "unit": "normalized",
          "cyclic": false
        },
        {
          "name": "thickness",
          "label": "Thickness",
          "min": 0.002,
          "max": 0.05,
          "default": 0.012,
          "unit": "normalized",
          "cyclic": false
        },
        {
          "name": "emission",
          "label": "Emission",
          "min": 0.1,
          "max": 8,
          "default": 1.4,
          "unit": "multiplier",
          "cyclic": false
        },
        {
          "name": "glow",
          "label": "Local glow",
          "min": 0,
          "max": 1,
          "default": 0.3,
          "unit": "normalized",
          "cyclic": false
        },
        {
          "name": "hue",
          "label": "Palette position",
          "min": 0,
          "max": 1,
          "default": 0.55,
          "unit": "normalized",
          "cyclic": true
        },
        {
          "name": "drift",
          "label": "Drift extent",
          "min": 0,
          "max": 1,
          "default": 0.12,
          "unit": "normalized",
          "cyclic": false
        },
        {
          "name": "beat_pulse",
          "label": "Beat pulse",
          "min": 0,
          "max": 1,
          "default": 0,
          "unit": "normalized",
          "cyclic": false
        },
        {
          "name": "shape_warp",
          "label": "Shape warp",
          "min": 0,
          "max": 0.2,
          "default": 0.025,
          "unit": "normalized",
          "cyclic": false
        }
      ]
    }
  ],
  "macros": [
    {
      "id": "intensity",
      "slot": 0,
      "label": "Intensity",
      "default": 0.3
    },
    {
      "id": "motion",
      "slot": 1,
      "label": "Motion",
      "default": 0.35
    },
    {
      "id": "color",
      "slot": 2,
      "label": "Color",
      "default": 0.55
    },
    {
      "id": "space",
      "slot": 3,
      "label": "Space",
      "default": 0.5
    }
  ],
  "modulators": [
    {
      "id": "kick",
      "type": "ad",
      "attackMs": 4,
      "decayMs": 180,
      "peak": 1,
      "retrigger": "max"
    },
    {
      "id": "breath",
      "type": "lfo",
      "shape": "sine",
      "periodBeats": 8,
      "phaseOffset": 0,
      "polarity": "bipolar"
    }
  ],
  "routes": [
    {
      "id": "macro-intensity",
      "source": "macro.intensity",
      "destination": "stage.halo.emission",
      "inputMin": 0,
      "inputMax": 1,
      "curve": "linear",
      "exponent": 1,
      "center": 0.3,
      "amount": 0.6,
      "attackMs": 20,
      "releaseMs": 180
    },
    {
      "id": "macro-intensity-glow",
      "source": "macro.intensity",
      "destination": "stage.halo.glow",
      "inputMin": 0,
      "inputMax": 1,
      "curve": "linear",
      "exponent": 1,
      "center": 0.3,
      "amount": 0.35,
      "attackMs": 20,
      "releaseMs": 180
    },
    {
      "id": "macro-motion",
      "source": "macro.motion",
      "destination": "stage.halo.drift",
      "inputMin": 0,
      "inputMax": 1,
      "curve": "linear",
      "exponent": 1,
      "center": 0.35,
      "amount": 0.8,
      "attackMs": 20,
      "releaseMs": 180
    },
    {
      "id": "macro-motion-warp",
      "source": "macro.motion",
      "destination": "stage.halo.shape_warp",
      "inputMin": 0,
      "inputMax": 1,
      "curve": "linear",
      "exponent": 1,
      "center": 0.35,
      "amount": 0.4,
      "attackMs": 20,
      "releaseMs": 180
    },
    {
      "id": "macro-color",
      "source": "macro.color",
      "destination": "stage.halo.hue",
      "inputMin": 0,
      "inputMax": 1,
      "curve": "linear",
      "exponent": 1,
      "center": 0.55,
      "amount": 1,
      "attackMs": 100,
      "releaseMs": 100
    },
    {
      "id": "macro-space",
      "source": "macro.space",
      "destination": "stage.halo.radius",
      "inputMin": 0,
      "inputMax": 1,
      "curve": "linear",
      "exponent": 1,
      "center": 0.5,
      "amount": 0.6,
      "attackMs": 20,
      "releaseMs": 180
    },
    {
      "id": "bass-body",
      "source": "audio.bass.activity",
      "destination": "stage.halo.radius",
      "inputMin": 0,
      "inputMax": 1,
      "curve": "power",
      "exponent": 0.75,
      "center": 0,
      "amount": 0.06,
      "attackMs": 35,
      "releaseMs": 180
    },
    {
      "id": "kick-pulse",
      "source": "env.kick",
      "destination": "stage.halo.beat_pulse",
      "inputMin": 0,
      "inputMax": 1,
      "curve": "linear",
      "exponent": 1,
      "center": 0,
      "amount": 1,
      "attackMs": 0,
      "releaseMs": 0
    },
    {
      "id": "high-shimmer",
      "source": "audio.high.activity",
      "destination": "stage.halo.glow",
      "inputMin": 0,
      "inputMax": 1,
      "curve": "linear",
      "exponent": 1,
      "center": 0,
      "amount": 0.1,
      "attackMs": 30,
      "releaseMs": 250
    },
    {
      "id": "slow-breath",
      "source": "lfo.breath",
      "destination": "stage.halo.radius",
      "inputMin": -1,
      "inputMax": 1,
      "curve": "linear",
      "exponent": 1,
      "center": 0.5,
      "amount": 0.04,
      "attackMs": 0,
      "releaseMs": 0
    }
  ],
  "triggers": [
    {
      "id": "kick-to-pulse",
      "on": "event.kick",
      "minStrength": 0.2,
      "refractoryMs": 90,
      "quantize": "none",
      "actions": [
        {
          "type": "envelope",
          "target": "kick",
          "amount": 1
        }
      ]
    },
    {
      "id": "manual-to-pulse",
      "on": "event.userTrigger",
      "minStrength": 0,
      "refractoryMs": 50,
      "quantize": "none",
      "actions": [
        {
          "type": "envelope",
          "target": "kick",
          "amount": 1
        }
      ]
    }
  ],
  "transition": {
    "type": "crossfade",
    "durationMs": 600,
    "quantize": "beat",
    "historyOnEnter": "reset",
    "retarget": "snapshot-current"
  },
  "post": {
    "bloom": {
      "enabled": true,
      "amount": 0.18,
      "threshold": 1,
      "levels": 4
    },
    "toneMap": "reinhard",
    "exposureEv": 0,
    "outputColorSpace": "srgb",
    "grain": 0.008,
    "vignette": 0.12
  },
  "performance": {
    "qualityTier": "light",
    "sceneBudgetMs1080p": 1.5,
    "deterministicSeed": 72317,
    "notes": "Scene-only GPU allocation target, not measured. Global finish/output budget is separate. No video dependency."
  }
}
