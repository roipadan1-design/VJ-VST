{
  "schemaVersion": "2.0",
  "id": "ikeda-bars",
  "name": "Ikeda Bars",
  "description": "Minimal white lines that re-arrange on the beat; code bars on hats, hard inverts on snares.",
  "author": "VJ VST",
  "license": "project-internal",
  "engine": {
    "minimumVersion": "0.2.0",
    "shaderProfile": "isf-legacy",
    "workingColorSpace": "linear-srgb",
    "featureContract": "2.0"
  },
  "sourcePolicy": {
    "bass": "kick-or-mix",
    "mid": "snare-or-mix",
    "high": "hat-or-mix",
    "level": "mix"
  },
  "stages": [
    {
      "id": "bars",
      "kind": "generator",
      "shader": "Instrument/ikeda_bars.fs",
      "targetFormat": "rgba16f",
      "scale": 1.0,
      "inputs": {},
      "parameters": [
        {
          "name": "density",
          "label": "Density",
          "min": 0.05,
          "max": 0.9,
          "default": 0.35,
          "unit": "normalized",
          "cyclic": false
        },
        {
          "name": "columns",
          "label": "Columns",
          "min": 8,
          "max": 200,
          "default": 48,
          "unit": "normalized",
          "cyclic": false
        },
        {
          "name": "thickness",
          "label": "Thickness",
          "min": 0.05,
          "max": 0.9,
          "default": 0.18,
          "unit": "normalized",
          "cyclic": false
        },
        {
          "name": "step_rate",
          "label": "Step Rate",
          "min": 0.25,
          "max": 8,
          "default": 2,
          "unit": "normalized",
          "cyclic": false
        },
        {
          "name": "code",
          "label": "Code",
          "min": 0,
          "max": 1,
          "default": 0,
          "unit": "normalized",
          "cyclic": false
        },
        {
          "name": "flash",
          "label": "Flash",
          "min": 0,
          "max": 1,
          "default": 0,
          "unit": "normalized",
          "cyclic": false
        },
        {
          "name": "brightness",
          "label": "Brightness",
          "min": 0.3,
          "max": 4,
          "default": 1.6,
          "unit": "normalized",
          "cyclic": false
        },
        {
          "name": "scan",
          "label": "Scan",
          "min": 0.0,
          "max": 2.0,
          "default": 0.3,
          "unit": "normalized",
          "cyclic": false,
          "integrate": true
        }
      ]
    }
  ],
  "macros": [
    {
      "id": "intensity",
      "slot": 0,
      "label": "Intensity",
      "default": 0.5
    },
    {
      "id": "motion",
      "slot": 1,
      "label": "Motion",
      "default": 0.4
    },
    {
      "id": "color",
      "slot": 2,
      "label": "Color",
      "default": 0.5
    },
    {
      "id": "space",
      "slot": 3,
      "label": "Space",
      "default": 0.5
    }
  ],
  "modulators": [
    {
      "id": "kick",
      "type": "ad",
      "attackMs": 3,
      "decayMs": 180,
      "peak": 1,
      "retrigger": "max"
    },
    {
      "id": "snare",
      "type": "ad",
      "attackMs": 2,
      "decayMs": 140,
      "peak": 1,
      "retrigger": "restart"
    },
    {
      "id": "hat",
      "type": "ad",
      "attackMs": 1,
      "decayMs": 70,
      "peak": 1,
      "retrigger": "restart"
    },
    {
      "id": "drift",
      "type": "lfo",
      "shape": "sine",
      "periodBeats": 16,
      "phaseOffset": 0,
      "polarity": "bipolar"
    }
  ],
  "routes": [
    {
      "id": "macro-intensity-bars-density",
      "source": "macro.intensity",
      "destination": "stage.bars.density",
      "inputMin": 0.0,
      "inputMax": 1.0,
      "curve": "linear",
      "exponent": 1.0,
      "center": 0.5,
      "amount": 0.6,
      "attackMs": 20,
      "releaseMs": 180
    },
    {
      "id": "macro-intensity-bars-brightness",
      "source": "macro.intensity",
      "destination": "stage.bars.brightness",
      "inputMin": 0.0,
      "inputMax": 1.0,
      "curve": "linear",
      "exponent": 1.0,
      "center": 0.5,
      "amount": 0.4,
      "attackMs": 20,
      "releaseMs": 180
    },
    {
      "id": "macro-motion-bars-step_rate",
      "source": "macro.motion",
      "destination": "stage.bars.step_rate",
      "inputMin": 0.0,
      "inputMax": 1.0,
      "curve": "linear",
      "exponent": 1.0,
      "center": 0.4,
      "amount": 0.8,
      "attackMs": 20,
      "releaseMs": 180
    },
    {
      "id": "macro-color-bars-thickness",
      "source": "macro.color",
      "destination": "stage.bars.thickness",
      "inputMin": 0.0,
      "inputMax": 1.0,
      "curve": "linear",
      "exponent": 1.0,
      "center": 0.5,
      "amount": 0.6,
      "attackMs": 20,
      "releaseMs": 180
    },
    {
      "id": "macro-space-bars-columns",
      "source": "macro.space",
      "destination": "stage.bars.columns",
      "inputMin": 0.0,
      "inputMax": 1.0,
      "curve": "linear",
      "exponent": 1.0,
      "center": 0.5,
      "amount": 0.7,
      "attackMs": 20,
      "releaseMs": 180
    },
    {
      "id": "env-hat-bars-code",
      "source": "env.hat",
      "destination": "stage.bars.code",
      "inputMin": 0.0,
      "inputMax": 1.0,
      "curve": "linear",
      "exponent": 1.0,
      "center": 0.0,
      "amount": 1.0,
      "attackMs": 0,
      "releaseMs": 0
    },
    {
      "id": "env-kick-bars-code",
      "source": "env.kick",
      "destination": "stage.bars.code",
      "inputMin": 0.0,
      "inputMax": 1.0,
      "curve": "linear",
      "exponent": 1.0,
      "center": 0.0,
      "amount": 0.5,
      "attackMs": 0,
      "releaseMs": 0
    },
    {
      "id": "env-snare-bars-flash",
      "source": "env.snare",
      "destination": "stage.bars.flash",
      "inputMin": 0.0,
      "inputMax": 1.0,
      "curve": "linear",
      "exponent": 1.0,
      "center": 0.0,
      "amount": 1.0,
      "attackMs": 0,
      "releaseMs": 0
    }
  ],
  "triggers": [
    {
      "id": "kick",
      "on": "event.kick",
      "minStrength": 0.1,
      "refractoryMs": 90,
      "quantize": "none",
      "actions": [
        {
          "type": "envelope",
          "target": "kick",
          "amount": 1
        }
      ]
    },
    {
      "id": "snare",
      "on": "event.snare",
      "minStrength": 0.1,
      "refractoryMs": 70,
      "quantize": "none",
      "actions": [
        {
          "type": "envelope",
          "target": "snare",
          "amount": 1
        }
      ]
    },
    {
      "id": "hat",
      "on": "event.hat",
      "minStrength": 0.1,
      "refractoryMs": 45,
      "quantize": "none",
      "actions": [
        {
          "type": "envelope",
          "target": "hat",
          "amount": 1
        }
      ]
    },
    {
      "id": "user",
      "on": "event.userTrigger",
      "minStrength": 0,
      "refractoryMs": 50,
      "quantize": "none",
      "actions": [
        {
          "type": "envelope",
          "target": "kick",
          "amount": 1
        }
      ]
    }
  ],
  "transition": {
    "type": "cut",
    "durationMs": 0,
    "quantize": "bar",
    "historyOnEnter": "reset",
    "retarget": "snapshot-current"
  },
  "post": {
    "bloom": {
      "enabled": true,
      "amount": 0.15,
      "threshold": 1.2,
      "levels": 4
    },
    "toneMap": "reinhard",
    "exposureEv": 0.8,
    "outputColorSpace": "srgb",
    "grain": 0.01,
    "vignette": 0.0
  },
  "performance": {
    "qualityTier": "medium",
    "sceneBudgetMs1080p": 3.0,
    "deterministicSeed": 808,
    "notes": "target, not measured"
  }
}
