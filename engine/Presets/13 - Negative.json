{
  "schemaVersion": "2.0",
  "id": "negative",
  "name": "Negative",
  "description": "A lattice pylon from the ground, split into two layers: the negative body in red, lit rims and wires in cyan. Kicks break it into per-channel 1-bit noise and (with Impact up) jump-cut the camera. Colours follow the palette as two layers (body = mid, detail = light); Scene Colors = red/cyan.",
  "author": "VJ VST",
  "license": "project-internal",
  "engine": {
    "minimumVersion": "0.2.0",
    "shaderProfile": "isf-legacy",
    "workingColorSpace": "linear-srgb",
    "featureContract": "2.0"
  },
  "sourcePolicy": {
    "bass": "kick-or-mix",
    "mid": "snare-or-mix",
    "high": "hat-or-mix",
    "level": "mix"
  },
  "stages": [
    {
      "id": "cam",
      "kind": "generator",
      "shader": "Instrument/pylon.fs",
      "targetFormat": "rgba16f",
      "scale": 1.0,
      "inputs": {},
