        {
          "name": "orbit",
          "label": "Orbit",
          "min": 0.0,
          "max": 0.3,
          "default": 0.12,
          "unit": "normalized",
          "cyclic": false,
          "integrate": true
        },
        {
          "name": "fov",
          "label": "Fov",
          "min": 0.6,
          "max": 1.8,
