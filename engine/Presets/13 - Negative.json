        {
          "name": "levels",
          "label": "Levels",
          "min": 5,
          "max": 12,
          "default": 8,
          "unit": "normalized",
          "cyclic": false
        },
        {
          "name": "beam",
          "label": "Beam",
          "min": 0.03,
          "max": 0.12,
          "default": 0.06,
          "unit": "normalized",
          "cyclic": false
        },
        {
          "name": "cuts",
          "label": "Cuts",
          "min": 0,
          "max": 1,
          "default": 0.5,
          "unit": "normalized",
          "cyclic": false
        },
        {
          "name": "tilt",
          "label": "Tilt",
          "min": 0,
          "max": 1,
          "default": 0.5,
          "unit": "normalized",
          "cyclic": false
