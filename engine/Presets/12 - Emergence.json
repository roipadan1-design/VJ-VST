{
  "schemaVersion": "2.0",
  "id": "emergence",
  "name": "Emergence",
  "description": "After The Noise Diary: an abstract form rises out of darkness with vertical light streaks, dissolves into dust as the music builds, re-forms in the quiet.",
  "author": "VJ VST",
  "license": "project-internal",
  "engine": {
    "minimumVersion": "0.2.0",
    "shaderProfile": "isf-legacy",
    "workingColorSpace": "linear-srgb",
    "featureContract": "2.0"
  },
  "sourcePolicy": {
    "bass": "kick-or-mix",
    "mid": "snare-or-mix",
    "high": "hat-or-mix",
    "level": "mix"
  },
  "stages": [
    {
      "id": "rise",
      "kind": "generator",
      "shader": "Instrument/emergence.fs",
      "targetFormat": "rgba16f",
      "scale": 1.0,
      "inputs": {},
      "parameters": [
        {
          "name": "zoom",
          "label": "Zoom",
          "min": 0.6,
          "max": 3.0,
          "default": 1.7,
          "unit": "normalized",
          "cyclic": false
        },
        {
          "name": "visible",
          "label": "Visible",
          "min": 0,
          "max": 1,
          "default": 0.45,
          "unit": "normalized",
          "cyclic": false
        },
        {
          "name": "streak",
          "label": "Streak",
          "min": 0,
          "max": 1,
          "default": 0.5,
          "unit": "normalized",
          "cyclic": false
        },
        {
          "name": "dissolve",
          "label": "Dissolve",
          "min": 0,
          "max": 1,
          "default": 0.12,
          "unit": "normalized",
          "cyclic": false
        },
        {
          "name": "drift",
          "label": "Drift",
          "min": 0.0,
          "max": 1.0,
          "default": 0.3,
          "unit": "normalized",
          "cyclic": false,
          "integrate": true
        },
        {
          "name": "surge",
          "label": "Surge",
          "min": 0,
          "max": 1,
          "default": 0,
          "unit": "normalized",
          "cyclic": false
        },
        {
          "name": "emission",
          "label": "Emission",
          "min": 0.2,
          "max": 4.0,
          "default": 0.95,
          "unit": "normalized",
          "cyclic": false
        }
      ],
      "sources": {
        "source": {
          "type": "images",
          "folder": "Images/Forms",
          "advance": "bar",
          "every": 8,
          "order": "random"
        }
      }
    }
  ],
  "macros": [
    {
      "id": "intensity",
      "slot": 0,
      "label": "Intensity",
      "default": 0.5
    },
    {
      "id": "motion",
      "slot": 1,
      "label": "Motion",
      "default": 0.4
