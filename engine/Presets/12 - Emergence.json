        {
          "name": "zoom",
          "label": "Zoom",
          "min": 0.6,
          "max": 3.0,
          "default": 1.7,
          "unit": "normalized",
          "cyclic": false
        },
        {
          "name": "visible",
          "label": "Visible",
          "min": 0,
          "max": 1,
          "default": 0.45,
          "unit": "normalized",
          "cyclic": false
