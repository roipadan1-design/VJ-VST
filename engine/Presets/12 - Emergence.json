{
  "schemaVersion": "2.0",
  "id": "emergence",
  "name": "Emergence",
  "description": "After The Noise Diary: an abstract form rises out of darkness with vertical light streaks, dissolves into dust as the music builds, appears on the drop. In silence only a faint trace.",
  "author": "VJ VST",
  "license": "project-internal",
  "engine": {
