{
  "schemaVersion": "2.0",
  "id": "morphogen",
  "name": "Morphogen",
  "description": "Reaction-diffusion grown live and lit as a relief; kicks plant seeds that grow roots, Color slides between fingerprint, coral, mitosis and worms.",
  "author": "VJ VST",
  "license": "project-internal",
  "engine": {
    "minimumVersion": "0.2.0",
    "shaderProfile": "isf-legacy",
    "workingColorSpace": "linear-srgb",
    "featureContract": "2.0"
  },
  "sourcePolicy": {
    "bass": "kick-or-mix",
    "mid": "snare-or-mix",
    "high": "hat-or-mix",
    "level": "mix"
  },
  "stages": [
    {
      "id": "rd",
      "kind": "generator",
      "shader": "Instrument/morphogen.fs",
      "targetFormat": "rgba16f",
      "scale": 1.0,
      "inputs": {},
      "parameters": [
        {
          "name": "pattern",
          "label": "Pattern",
          "min": 0,
          "max": 1,
          "default": 0.35,
          "unit": "normalized",
          "cyclic": false
        },
        {
          "name": "rate",
          "label": "Rate",
          "min": 0.2,
          "max": 1.0,
          "default": 0.9,
          "unit": "normalized",
          "cyclic": false
        },
        {
          "name": "seed_amt",
          "label": "Seed Amt",
          "min": 0,
          "max": 1,
          "default": 0,
          "unit": "normalized",
          "cyclic": false
        },
        {
          "name": "zoom",
          "label": "Zoom",
          "min": 0.6,
          "max": 2.0,
          "default": 1.0,
          "unit": "normalized",
          "cyclic": false
        },
        {
          "name": "relief",
          "label": "Relief",
          "min": 0,
          "max": 1.5,
          "default": 0.6,
          "unit": "normalized",
          "cyclic": false
        },
        {
          "name": "boundary",
          "label": "Boundary",
          "min": 0,
          "max": 1,
          "default": 0.55,
          "unit": "normalized",
          "cyclic": false
        },
        {
          "name": "emission",
          "label": "Emission",
          "min": 0.2,
          "max": 4.0,
          "default": 1.2,
          "unit": "normalized",
          "cyclic": false
        }
      ]
    }
  ],
  "macros": [
    {
      "id": "intensity",
      "slot": 0,
      "label": "Intensity",
      "default": 0.5
    },
    {
      "id": "motion",
      "slot": 1,
      "label": "Motion",
      "default": 0.4
    },
    {
      "id": "color",
      "slot": 2,
      "label": "Color",
      "default": 0.5
    },
    {
      "id": "space",
      "slot": 3,
      "label": "Space",
      "default": 0.5
    },
    {
      "id": "impact",
      "slot": 4,
      "label": "Impact",
      "default": 0.5
    },
    {
      "id": "gravity",
      "slot": 5,
      "label": "Gravity",
      "default": 0.5
    },
    {
      "id": "viscosity",
      "slot": 6,
      "label": "Viscosity",
      "default": 0.5
    },
    {
      "id": "detail",
      "slot": 7,
      "label": "Detail",
      "default": 0.5
    }
  ],
  "modulators": [
    {
      "id": "kick",
      "type": "ad",
      "attackMs": 3,
      "decayMs": 180,
      "peak": 1,
      "retrigger": "max"
    },
    {
      "id": "snare",
      "type": "ad",
      "attackMs": 2,
      "decayMs": 140,
      "peak": 1,
      "retrigger": "restart"
    },
    {
      "id": "hat",
      "type": "ad",
      "attackMs": 1,
      "decayMs": 70,
      "peak": 1,
      "retrigger": "restart"
    },
    {
      "id": "swell",
      "type": "ad",
      "attackMs": 5,
      "decayMs": 900,
      "peak": 1,
      "retrigger": "max"
    },
    {
      "id": "drop",
      "type": "ad",
      "attackMs": 1,
      "decayMs": 60,
      "peak": 1,
      "retrigger": "restart"
    },
    {
      "id": "drift",
      "type": "lfo",
      "shape": "sine",
      "periodBeats": 16,
      "phaseOffset": 0,
      "polarity": "bipolar"
    },
    {
      "id": "phrase",
      "type": "lfo",
      "shape": "sine",
      "periodBeats": 64,
      "phaseOffset": 0,
      "polarity": "bipolar"
    }
  ],
  "routes": [
    {
      "id": "macro-intensity-rd-emission",
      "source": "macro.intensity",
      "destination": "stage.rd.emission",
      "inputMin": 0.0,
      "inputMax": 1.0,
      "curve": "linear",
      "exponent": 1.0,
      "center": 0.5,
      "amount": 0.6,
      "attackMs": 20,
      "releaseMs": 180
    },
    {
      "id": "macro-color-rd-pattern",
      "source": "macro.color",
      "destination": "stage.rd.pattern",
      "inputMin": 0.0,
      "inputMax": 1.0,
      "curve": "linear",
      "exponent": 1.0,
      "center": 0.5,
      "amount": 0.9,
      "attackMs": 20,
      "releaseMs": 180
    },
    {
      "id": "macro-motion-rd-rate",
      "source": "macro.motion",
      "destination": "stage.rd.rate",
      "inputMin": 0.0,
      "inputMax": 1.0,
      "curve": "linear",
      "exponent": 1.0,
      "center": 0.4,
      "amount": 0.8,
      "attackMs": 20,
      "releaseMs": 180
    },
    {
      "id": "macro-space-rd-zoom",
      "source": "macro.space",
      "destination": "stage.rd.zoom",
      "inputMin": 0.0,
      "inputMax": 1.0,
      "curve": "linear",
      "exponent": 1.0,
      "center": 0.5,
      "amount": 0.6,
      "attackMs": 20,
      "releaseMs": 180
    },
    {
      "id": "macro-space-rd-boundary",
      "source": "macro.space",
      "destination": "stage.rd.boundary",
      "inputMin": 0.0,
      "inputMax": 1.0,
      "curve": "linear",
      "exponent": 1.0,
      "center": 0.5,
      "amount": -0.6,
      "attackMs": 20,
      "releaseMs": 180
    },
    {
      "id": "macro-detail-rd-relief",
      "source": "macro.detail",
      "destination": "stage.rd.relief",
      "inputMin": 0.0,
      "inputMax": 1.0,
      "curve": "linear",
      "exponent": 1.0,
      "center": 0.5,
      "amount": 0.8,
      "attackMs": 20,
      "releaseMs": 180
    },
    {
      "id": "macro-gravity-rd-boundary",
      "source": "macro.gravity",
      "destination": "stage.rd.boundary",
      "inputMin": 0.0,
      "inputMax": 1.0,
      "curve": "linear",
      "exponent": 1.0,
      "center": 0.5,
      "amount": 0.5,
      "attackMs": 20,
      "releaseMs": 180
    },
    {
      "id": "descriptor-build-rd-rate",
      "source": "descriptor.build",
      "destination": "stage.rd.rate",
      "inputMin": 0.0,
      "inputMax": 1.0,
      "curve": "linear",
      "exponent": 1.0,
      "center": 0.0,
      "amount": 0.2,
      "attackMs": 120,
      "releaseMs": 400
    },
    {
      "id": "env-drop-rd-seed_amt",
      "source": "env.drop",
      "destination": "stage.rd.seed_amt",
      "inputMin": 0.0,
      "inputMax": 1.0,
      "curve": "linear",
      "exponent": 1.0,
      "center": 0.0,
      "amount": 1.0,
      "attackMs": 0,
      "releaseMs": 0,
      "scaleBy": "macro.impact"
    },
    {
      "id": "lfo-phrase-rd-pattern",
      "source": "lfo.phrase",
      "destination": "stage.rd.pattern",
      "inputMin": 0.0,
      "inputMax": 1.0,
      "curve": "linear",
      "exponent": 1.0,
      "center": 0.5,
      "amount": 0.15,
      "attackMs": 0,
      "releaseMs": 0
    }
  ],
  "triggers": [
    {
      "id": "kick",
      "on": "event.kick",
      "minStrength": 0.1,
      "refractoryMs": 90,
      "quantize": "none",
      "actions": [
        {
          "type": "envelope",
          "target": "kick",
          "amount": 1
        },
        {
          "type": "envelope",
          "target": "swell",
          "amount": 1
        },
        {
          "type": "envelope",
          "target": "drop",
          "amount": 1
        },
        {
          "type": "reseed"
        }
      ]
    },
    {
      "id": "snare",
      "on": "event.snare",
      "minStrength": 0.1,
      "refractoryMs": 70,
      "quantize": "none",
      "actions": [
        {
          "type": "envelope",
          "target": "snare",
          "amount": 1
        }
      ]
    },
    {
      "id": "hat",
      "on": "event.hat",
      "minStrength": 0.1,
      "refractoryMs": 45,
      "quantize": "none",
      "actions": [
        {
          "type": "envelope",
          "target": "hat",
          "amount": 1
        }
      ]
    },
    {
      "id": "user",
      "on": "event.userTrigger",
      "minStrength": 0,
      "refractoryMs": 50,
      "quantize": "none",
      "actions": [
        {
          "type": "envelope",
          "target": "kick",
          "amount": 1
        },
        {
          "type": "envelope",
          "target": "swell",
          "amount": 1
        },
        {
          "type": "envelope",
          "target": "drop",
          "amount": 1
        },
        {
          "type": "reseed"
        }
      ]
    }
  ],
  "transition": {
    "type": "cut",
    "durationMs": 0,
    "quantize": "beat",
    "historyOnEnter": "keep",
    "retarget": "snapshot-current"
  },
  "post": {
    "bloom": {
      "enabled": true,
      "amount": 0.22,
      "threshold": 0.9,
      "levels": 5
    },
    "toneMap": "reinhard",
    "exposureEv": 0.3,
    "outputColorSpace": "srgb",
    "grain": 0.0,
    "vignette": 0.25
  },
  "performance": {
    "qualityTier": "medium",
    "sceneBudgetMs1080p": 3.0,
    "deterministicSeed": 1111,
    "notes": "target, not measured"
  }
}
