            "audioMappings": {
                "jitterAmount": { "source": "onset", "scale": 0.12, "offset": 0.004 }
            }
        },
        {
            "shader": "Glitch/BlockGlitch.fs",
            "params": { "intensity": 0.0, "blockCount": 24 },
            "audioMappings": {
                "intensity": { "source": "bass", "scale": 0.4, "offset": 0.0 }
            }
        }
    ]
}
