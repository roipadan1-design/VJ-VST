{
  "schemaVersion": "2.0",
  "id": "media-lines",
  "name": "Media Lines",
  "description": "Your loaded image redrawn as fine light linework on black with a sparse stipple, drifting slowly; accents burn the lines, the drop floods the image in. Shows the built-in forms until an image is loaded.",
  "author": "VJ VST",
  "license": "project-internal",
  "engine": {
    "minimumVersion": "0.2.0",
    "shaderProfile": "isf-legacy",
    "workingColorSpace": "linear-srgb",
    "featureContract": "2.0"
  },
  "sourcePolicy": {
    "bass": "kick-or-mix",
    "mid": "snare-or-mix",
    "high": "hat-or-mix",
    "level": "mix"
  },
  "stages": [
    {
      "id": "frame",
      "kind": "generator",
      "shader": "Instrument/media_frame.fs",
      "targetFormat": "rgba16f",
      "scale": 1.0,
      "inputs": {},
      "parameters": [
        {
          "name": "zoom",
          "label": "Zoom",
          "min": 0.6,
          "max": 2.5,
          "default": 1.0,
          "unit": "normalized",
          "cyclic": false
        },
        {
          "name": "fit",
          "label": "Fit",
          "min": 0,
          "max": 1,
          "default": 0.0,
          "unit": "normalized",
          "cyclic": false
        },
        {
          "name": "wander",
          "label": "Wander",
          "min": 0.0,
          "max": 0.5,
          "default": 0.1,
          "unit": "normalized",
          "cyclic": false,
          "integrate": true
        },
        {
          "name": "roam",
          "label": "Roam",
          "min": 0,
          "max": 1,
          "default": 0.5,
          "unit": "normalized",
          "cyclic": false
        },
        {
          "name": "surge",
          "label": "Surge",
          "min": 0,
          "max": 2.5,
          "default": 0,
          "unit": "normalized",
          "cyclic": false
        }
      ],
      "sources": {
        "source": {
          "type": "media",
          "fallback": "Images/Forms",
          "advance": "none"
        }
      }
    },
    {
      "id": "lines",
      "kind": "effect",
      "shader": "Instrument/media_lines.fs",
      "targetFormat": "rgba16f",
      "scale": 1.0,
      "inputs": {},
      "parameters": [
        {
          "name": "radius",
          "label": "Radius",
          "min": 0.8,
          "max": 4.0,
          "default": 1.6,
          "unit": "normalized",
          "cyclic": false
        },
        {
          "name": "threshold",
          "label": "Threshold",
          "min": 0.005,
          "max": 0.2,
          "default": 0.04,
          "unit": "normalized",
          "cyclic": false
        },
        {
          "name": "dots",
          "label": "Dots",
          "min": 0,
          "max": 1,
          "default": 0.3,
          "unit": "normalized",
          "cyclic": false
        },
        {
          "name": "fill",
          "label": "Fill",
          "min": 0,
          "max": 0.5,
          "default": 0.1,
          "unit": "normalized",
          "cyclic": false
        },
        {
          "name": "flash",
          "label": "Flash",
          "min": 0,
          "max": 1,
          "default": 0,
          "unit": "normalized",
          "cyclic": false
        },
        {
          "name": "emission",
          "label": "Emission",
          "min": 0.2,
          "max": 4.0,
          "default": 1.8,
          "unit": "normalized",
          "cyclic": false
        }
      ]
    }
  ],
  "macros": [
    {
      "id": "intensity",
      "slot": 0,
      "label": "glow",
      "default": 0.5
    },
    {
      "id": "speed",
      "slot": 1,
      "label": "Speed",
      "default": 0.5
    },
    {
      "id": "form",
      "slot": 2,
      "label": "stipple",
      "default": 0.5
    },
    {
      "id": "scale",
      "slot": 3,
      "label": "zoom",
      "default": 0.5
    },
    {
      "id": "react",
      "slot": 4,
      "label": "React",
      "default": 0.5
    },
    {
      "id": "erode",
      "slot": 5,
      "label": "fading lines",
      "default": 0.5
    },
    {
      "id": "glide",
      "slot": 6,
      "label": "Glide",
      "default": 0.25
    },
    {
      "id": "detail",
      "slot": 7,
      "label": "fine lines",
      "default": 0.5
    }
  ],
  "modulators": [
    {
      "id": "hit",
      "type": "ad",
      "attackMs": 0,
      "decayMs": 1300,
      "peak": 1,
      "retrigger": "max",
      "style": "hit"
    },
    {
      "id": "snare",
      "type": "ad",
      "attackMs": 2,
      "decayMs": 800,
      "peak": 1,
      "retrigger": "restart",
      "style": "snare"
    },
    {
      "id": "drop",
      "type": "ad",
      "attackMs": 0,
      "decayMs": 4000,
      "peak": 1,
      "retrigger": "max",
      "style": "drop"
    },
    {
      "id": "pulse",
      "type": "ad",
      "attackMs": 1,
      "decayMs": 80,
      "peak": 1,
      "retrigger": "restart"
    },
    {
      "id": "phrase",
      "type": "lfo",
      "shape": "sine",
      "periodBeats": 64,
      "phaseOffset": 0,
      "polarity": "bipolar"
    }
  ],
  "routes": [
    {
      "id": "macro-intensity-lines-emission",
      "source": "macro.intensity",
      "destination": "stage.lines.emission",
      "inputMin": 0.0,
      "inputMax": 1.0,
      "curve": "linear",
      "exponent": 1.0,
      "center": 0.5,
      "amount": 0.6,
      "attackMs": 60,
      "releaseMs": 60
    },
    {
      "id": "macro-intensity-lines-fill",
      "source": "macro.intensity",
      "destination": "stage.lines.fill",
      "inputMin": 0.0,
      "inputMax": 1.0,
      "curve": "linear",
      "exponent": 1.0,
      "center": 0.5,
      "amount": 0.3,
      "attackMs": 60,
      "releaseMs": 60
    },
    {
      "id": "macro-form-lines-dots",
      "source": "macro.form",
      "destination": "stage.lines.dots",
      "inputMin": 0.0,
      "inputMax": 1.0,
      "curve": "linear",
      "exponent": 1.0,
      "center": 0.5,
      "amount": 0.8,
      "attackMs": 60,
      "releaseMs": 60
    },
    {
      "id": "macro-scale-frame-zoom",
      "source": "macro.scale",
      "destination": "stage.frame.zoom",
      "inputMin": 0.0,
      "inputMax": 1.0,
      "curve": "linear",
      "exponent": 1.0,
      "center": 0.5,
      "amount": 0.6,
      "attackMs": 60,
      "releaseMs": 60
    },
    {
      "id": "macro-erode-lines-threshold",
      "source": "macro.erode",
      "destination": "stage.lines.threshold",
      "inputMin": 0.0,
      "inputMax": 1.0,
      "curve": "linear",
      "exponent": 1.0,
      "center": 0.5,
      "amount": 0.5,
      "attackMs": 60,
      "releaseMs": 60
    },
    {
      "id": "macro-detail-lines-radius",
      "source": "macro.detail",
      "destination": "stage.lines.radius",
      "inputMin": 0.0,
      "inputMax": 1.0,
      "curve": "linear",
      "exponent": 1.0,
      "center": 0.5,
      "amount": -0.6,
      "attackMs": 60,
      "releaseMs": 60
    },
    {
      "id": "react-energy-lines-threshold",
      "source": "react.energy",
      "destination": "stage.lines.threshold",
      "inputMin": 0.0,
      "inputMax": 1.0,
      "curve": "linear",
      "exponent": 1.0,
      "center": 0.5,
      "amount": -0.3,
      "attackMs": 0,
      "releaseMs": 0
    },
    {
      "id": "env-hit-lines-flash",
      "source": "env.hit",
      "destination": "stage.lines.flash",
      "inputMin": 0.0,
      "inputMax": 1.0,
      "curve": "linear",
      "exponent": 1.0,
      "center": 0.0,
      "amount": 1.0,
      "attackMs": 0,
      "releaseMs": 0
    },
    {
      "id": "react-body-frame-surge",
      "source": "react.body",
      "destination": "stage.frame.surge",
      "inputMin": 0.0,
      "inputMax": 1.0,
      "curve": "linear",
      "exponent": 1.0,
      "center": 0.0,
      "amount": 0.5,
      "attackMs": 0,
      "releaseMs": 0
    },
    {
      "id": "react-tension-lines-radius",
      "source": "react.tension",
      "destination": "stage.lines.radius",
      "inputMin": 0.0,
      "inputMax": 1.0,
      "curve": "linear",
      "exponent": 1.0,
      "center": 0.0,
      "amount": 0.3,
      "attackMs": 0,
      "releaseMs": 0
    },
    {
      "id": "env-drop-lines-fill",
      "source": "env.drop",
      "destination": "stage.lines.fill",
      "inputMin": 0.0,
      "inputMax": 1.0,
      "curve": "linear",
      "exponent": 1.0,
      "center": 0.0,
      "amount": 0.6,
      "attackMs": 0,
      "releaseMs": 0
    },
    {
      "id": "react-air-lines-dots",
      "source": "react.air",
      "destination": "stage.lines.dots",
      "inputMin": 0.0,
      "inputMax": 1.0,
      "curve": "linear",
      "exponent": 1.0,
      "center": 0.3,
      "amount": 0.3,
      "attackMs": 0,
      "releaseMs": 0
    }
  ],
  "triggers": [
    {
      "id": "accent",
      "on": "event.accent",
      "minStrength": 0,
      "refractoryMs": 0,
      "quantize": "none",
      "actions": [
        {
          "type": "envelope",
          "target": "hit",
          "amount": 1
        },
        {
          "type": "envelope",
          "target": "pulse",
          "amount": 1
        }
      ]
    },
    {
      "id": "tick",
      "on": "event.tick",
      "minStrength": 0,
      "refractoryMs": 0,
      "quantize": "none",
      "actions": [
        {
          "type": "envelope",
          "target": "hit",
          "amount": 1,
          "scale": "tick"
        }
      ]
    },
    {
      "id": "snare",
      "on": "event.snare",
      "minStrength": 0.1,
      "refractoryMs": 70,
      "quantize": "none",
      "actions": [
        {
          "type": "envelope",
          "target": "snare",
          "amount": 1,
          "scale": "snare"
        }
      ]
    },
    {
      "id": "drop",
      "on": "event.drop",
      "minStrength": 0,
      "refractoryMs": 0,
      "quantize": "none",
      "actions": [
        {
          "type": "envelope",
          "target": "drop",
          "amount": 1
        }
      ]
    }
  ],
  "transition": {
    "type": "cut",
    "durationMs": 0,
    "quantize": "beat",
    "historyOnEnter": "reset",
    "retarget": "snapshot-current"
  },
  "post": {
    "bloom": {
      "enabled": true,
      "amount": 0.22,
      "threshold": 0.9,
      "levels": 5
    },
    "toneMap": "reinhard",
    "exposureEv": 0.3,
    "outputColorSpace": "srgb",
    "grain": 0.0,
    "vignette": 0.25
  },
  "performance": {
    "qualityTier": "medium",
    "sceneBudgetMs1080p": 3.0,
    "deterministicSeed": 1616,
    "notes": "target, not measured"
  }
}
