        {
          "name": "haze",
          "label": "Haze",
          "min": 0,
          "max": 1,
          "default": 0.25,
          "unit": "normalized",
          "cyclic": false
        },
        {
          "name": "grain_size",
          "label": "Grain Size",
          "min": 1.0,
          "max": 4.0,
          "default": 1.4,
          "unit": "normalized",
          "cyclic": false
        },
        {
          "name": "surge",
          "label": "Surge",
          "min": 0,
          "max": 1.6,
          "default": 0,
          "unit": "normalized",
          "cyclic": false
