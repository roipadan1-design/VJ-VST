        {
          "name": "clock",
          "label": "Clock",
          "min": 0.0,
          "max": 0.6,
          "default": 0.15,
          "unit": "normalized",
          "cyclic": false,
          "integrate": true
        },
        {
          "name": "scale",
          "label": "Scale",
          "min": 0.4,
          "max": 4.0,
          "default": 1.3,
          "unit": "normalized",
          "cyclic": false
