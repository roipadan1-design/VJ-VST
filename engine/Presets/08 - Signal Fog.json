{
  "schemaVersion": "2.0",
  "id": "signal-fog",
  "name": "Signal Fog",
  "description": "After Rainer Kohlberger: extremely fine particles flutter over black while large forms condense out of the haze; build-ups swallow them in haze, the drop snaps them into focus.",
  "author": "VJ VST",
  "license": "project-internal",
  "engine": {
    "minimumVersion": "0.2.0",
    "shaderProfile": "isf-legacy",
    "workingColorSpace": "linear-srgb",
    "featureContract": "2.0"
  },
  "sourcePolicy": {
    "bass": "kick-or-mix",
    "mid": "snare-or-mix",
    "high": "hat-or-mix",
    "level": "mix"
  },
