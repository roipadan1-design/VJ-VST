{
  "schemaVersion": "2.0",
  "id": "hot-blobs",
  "name": "Hot Blobs",
  "description": "Thresholded liquid shapes filled with a vivid gradient and white rims; the palette steps on snares.",
  "author": "VJ VST",
  "license": "project-internal",
  "engine": {
    "minimumVersion": "0.2.0",
    "shaderProfile": "isf-legacy",
    "workingColorSpace": "linear-srgb",
    "featureContract": "2.0"
  },
  "sourcePolicy": {
    "bass": "kick-or-mix",
    "mid": "snare-or-mix",
    "high": "hat-or-mix",
    "level": "mix"
  },
  "stages": [
    {
      "id": "blobs",
      "kind": "generator",
      "shader": "Instrument/hot_blobs.fs",
      "targetFormat": "rgba16f",
      "scale": 1.0,
      "inputs": {},
      "parameters": [
        {
          "name": "scale",
          "label": "Scale",
          "min": 0.8,
          "max": 4.0,
          "default": 1.8,
          "unit": "normalized",
          "cyclic": false
        },
        {
          "name": "flow",
          "label": "Flow",
          "min": 0.0,
          "max": 0.6,
          "default": 0.12,
          "unit": "normalized",
          "cyclic": false,
          "integrate": true
        },
        {
          "name": "threshold",
          "label": "Threshold",
          "min": 0.38,
          "max": 0.64,
          "default": 0.53,
          "unit": "normalized",
          "cyclic": false
        },
        {
          "name": "rim",
          "label": "Rim",
          "min": 0,
          "max": 2,
          "default": 0.7,
          "unit": "normalized",
          "cyclic": false
        },
        {
          "name": "gradient",
          "label": "Gradient",
          "min": 0.0,
          "max": 1.5,
          "default": 0.3,
          "unit": "normalized",
          "cyclic": false,
          "integrate": true
        },
        {
          "name": "hue",
          "label": "Hue",
          "min": 0,
          "max": 1,
          "default": 0.5,
          "unit": "normalized",
          "cyclic": true
        },
        {
          "name": "surge",
          "label": "Surge",
          "min": 0,
          "max": 1,
          "default": 0,
          "unit": "normalized",
          "cyclic": false
        },
        {
          "name": "emission",
          "label": "Emission",
          "min": 0.3,
          "max": 3.0,
          "default": 1.2,
          "unit": "normalized",
          "cyclic": false
        },
        {
          "name": "grain",
          "label": "Grain",
          "min": 0,
          "max": 1,
          "default": 0.35,
          "unit": "normalized",
          "cyclic": false
        }
      ]
    }
  ],
  "macros": [
    {
      "id": "intensity",
      "slot": 0,
      "label": "Intensity",
      "default": 0.5
    },
    {
      "id": "motion",
      "slot": 1,
      "label": "Motion",
      "default": 0.4
    },
    {
      "id": "color",
      "slot": 2,
      "label": "Color",
      "default": 0.5
    },
    {
      "id": "space",
      "slot": 3,
      "label": "Space",
      "default": 0.5
    }
  ],
  "modulators": [
    {
      "id": "kick",
      "type": "ad",
      "attackMs": 3,
      "decayMs": 180,
      "peak": 1,
      "retrigger": "max"
    },
    {
      "id": "snare",
      "type": "ad",
      "attackMs": 2,
      "decayMs": 140,
      "peak": 1,
      "retrigger": "restart"
    },
    {
      "id": "hat",
      "type": "ad",
      "attackMs": 1,
      "decayMs": 70,
      "peak": 1,
      "retrigger": "restart"
    },
    {
      "id": "drift",
      "type": "lfo",
      "shape": "sine",
      "periodBeats": 16,
      "phaseOffset": 0,
      "polarity": "bipolar"
    }
  ],
  "routes": [
    {
      "id": "macro-intensity-blobs-emission",
      "source": "macro.intensity",
      "destination": "stage.blobs.emission",
      "inputMin": 0.0,
      "inputMax": 1.0,
      "curve": "linear",
      "exponent": 1.0,
      "center": 0.5,
      "amount": 0.6,
      "attackMs": 20,
      "releaseMs": 180
    },
    {
      "id": "macro-intensity-blobs-rim",
      "source": "macro.intensity",
      "destination": "stage.blobs.rim",
      "inputMin": 0.0,
      "inputMax": 1.0,
      "curve": "linear",
      "exponent": 1.0,
      "center": 0.5,
      "amount": 0.4,
      "attackMs": 20,
      "releaseMs": 180
    },
    {
      "id": "macro-motion-blobs-flow",
      "source": "macro.motion",
      "destination": "stage.blobs.flow",
      "inputMin": 0.0,
      "inputMax": 1.0,
      "curve": "linear",
      "exponent": 1.0,
      "center": 0.4,
      "amount": 0.9,
      "attackMs": 20,
      "releaseMs": 180
    },
    {
      "id": "macro-motion-blobs-gradient",
      "source": "macro.motion",
      "destination": "stage.blobs.gradient",
      "inputMin": 0.0,
      "inputMax": 1.0,
      "curve": "linear",
      "exponent": 1.0,
      "center": 0.4,
      "amount": 0.6,
      "attackMs": 20,
      "releaseMs": 180
    },
    {
      "id": "macro-color-blobs-hue",
      "source": "macro.color",
      "destination": "stage.blobs.hue",
      "inputMin": 0.0,
      "inputMax": 1.0,
      "curve": "linear",
      "exponent": 1.0,
      "center": 0.5,
      "amount": 1.0,
      "attackMs": 20,
      "releaseMs": 180
    },
    {
      "id": "macro-space-blobs-scale",
      "source": "macro.space",
      "destination": "stage.blobs.scale",
      "inputMin": 0.0,
      "inputMax": 1.0,
      "curve": "linear",
      "exponent": 1.0,
      "center": 0.5,
      "amount": -0.7,
      "attackMs": 20,
      "releaseMs": 180
    },
    {
      "id": "macro-space-blobs-threshold",
      "source": "macro.space",
      "destination": "stage.blobs.threshold",
      "inputMin": 0.0,
      "inputMax": 1.0,
      "curve": "linear",
      "exponent": 1.0,
      "center": 0.5,
      "amount": 0.4,
      "attackMs": 20,
      "releaseMs": 180
    },
    {
      "id": "env-kick-blobs-surge",
      "source": "env.kick",
      "destination": "stage.blobs.surge",
      "inputMin": 0.0,
      "inputMax": 1.0,
      "curve": "linear",
      "exponent": 1.0,
      "center": 0.0,
      "amount": 1.0,
      "attackMs": 0,
      "releaseMs": 0
    },
    {
      "id": "env-hat-blobs-grain",
      "source": "env.hat",
      "destination": "stage.blobs.grain",
      "inputMin": 0.0,
      "inputMax": 1.0,
      "curve": "linear",
      "exponent": 1.0,
      "center": 0.0,
      "amount": 0.4,
      "attackMs": 0,
      "releaseMs": 0
    },
    {
      "id": "audio-level-activity-blobs-threshold",
      "source": "audio.level.activity",
      "destination": "stage.blobs.threshold",
      "inputMin": 0.0,
      "inputMax": 1.0,
      "curve": "power",
      "exponent": 1.4,
      "center": 0.0,
      "amount": -0.25,
      "attackMs": 30,
      "releaseMs": 220
    }
  ],
  "triggers": [
    {
      "id": "kick",
      "on": "event.kick",
      "minStrength": 0.1,
      "refractoryMs": 90,
      "quantize": "none",
      "actions": [
        {
          "type": "envelope",
          "target": "kick",
          "amount": 1
        }
      ]
    },
    {
      "id": "snare",
      "on": "event.snare",
      "minStrength": 0.1,
      "refractoryMs": 70,
      "quantize": "none",
      "actions": [
        {
          "type": "envelope",
          "target": "snare",
          "amount": 1
        }
      ]
    },
    {
      "id": "hat",
      "on": "event.hat",
      "minStrength": 0.1,
      "refractoryMs": 45,
      "quantize": "none",
      "actions": [
        {
          "type": "envelope",
          "target": "hat",
          "amount": 1
        }
      ]
    },
    {
      "id": "user",
      "on": "event.userTrigger",
      "minStrength": 0,
      "refractoryMs": 50,
      "quantize": "none",
      "actions": [
        {
          "type": "envelope",
          "target": "kick",
          "amount": 1
        }
      ]
    },
    {
      "id": "palette",
      "on": "event.snare",
      "minStrength": 0.3,
      "refractoryMs": 1500,
      "quantize": "beat",
      "actions": [
        {
          "type": "palette-advance",
          "steps": 1
        }
      ]
    }
  ],
  "transition": {
    "type": "cut",
    "durationMs": 0,
    "quantize": "bar",
    "historyOnEnter": "reset",
    "retarget": "snapshot-current"
  },
  "post": {
    "bloom": {
      "enabled": true,
      "amount": 0.25,
      "threshold": 0.9,
      "levels": 5
    },
    "toneMap": "reinhard",
    "exposureEv": 0.3,
    "outputColorSpace": "srgb",
    "grain": 0.025,
    "vignette": 0.2
  },
  "performance": {
    "qualityTier": "medium",
    "sceneBudgetMs1080p": 3.0,
    "deterministicSeed": 202,
    "notes": "target, not measured"
  }
}
