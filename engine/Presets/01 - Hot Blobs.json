{
  "schemaVersion": "2.0",
  "id": "hot-blobs",
  "name": "Hot Blobs",
  "description": "A liquid mass hit by sound: each kick throws it and drops a stone into a ripple tank, gravity pulls it back, viscosity slows it.",
  "author": "VJ VST",
  "license": "project-internal",
  "engine": {
