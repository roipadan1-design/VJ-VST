        {
          "name": "impact",
          "label": "Impact",
          "min": 0,
          "max": 2,
          "default": 0.8,
          "unit": "normalized",
          "cyclic": false
        },
        {
          "name": "gravity",
          "label": "Gravity",
          "min": 0,
          "max": 2,
          "default": 0.6,
          "unit": "normalized",
          "cyclic": false
