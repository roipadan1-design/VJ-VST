        {
          "name": "emission",
          "label": "Emission",
          "min": 0.3,
          "max": 3.0,
          "default": 1.2,
          "unit": "normalized",
          "cyclic": false
        },
        {
          "name": "curl",
          "label": "Curl",
          "min": 0.4,
          "max": 3.0,
          "default": 1.6,
          "unit": "normalized",
          "cyclic": false
        }
      ]
