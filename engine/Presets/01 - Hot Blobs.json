{
  "schemaVersion": "2.0",
  "id": "hot-blobs",
  "name": "Hot Blobs",
  "description": "A liquid mass hit by sound: each kick throws it and drops a stone into a ripple tank, gravity pulls it back.",
  "author": "VJ VST",
  "license": "project-internal",
  "engine": {
    "minimumVersion": "0.2.0",
    "shaderProfile": "isf-legacy",
    "workingColorSpace": "linear-srgb",
    "featureContract": "2.0"
  },
  "sourcePolicy": {
    "bass": "kick-or-mix",
    "mid": "snare-or-mix",
    "high": "hat-or-mix",
    "level": "mix"
  },
  "stages": [
    {
      "id": "blobs",
      "kind": "generator",
      "shader": "Instrument/hot_blobs.fs",
      "targetFormat": "rgba16f",
      "scale": 1.0,
      "inputs": {},
      "parameters": [
        {
          "name": "scale",
          "label": "Scale",
          "min": 0.8,
          "max": 4.0,
          "default": 1.8,
          "unit": "normalized",
          "cyclic": false
        },
        {
          "name": "flow",
          "label": "Flow",
          "min": 0.0,
          "max": 0.6,
          "default": 0.1,
          "unit": "normalized",
          "cyclic": false,
          "integrate": true
        },
        {
          "name": "threshold",
          "label": "Threshold",
          "min": 0.38,
          "max": 0.64,
          "default": 0.53,
          "unit": "normalized",
          "cyclic": false
        },
        {
          "name": "drop",
          "label": "Drop",
          "min": 0,
          "max": 1,
          "default": 0,
          "unit": "normalized",
          "cyclic": false
