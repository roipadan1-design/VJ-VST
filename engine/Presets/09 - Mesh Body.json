{
  "schemaVersion": "2.0",
  "id": "mesh-body",
  "name": "Mesh Body",
  "description": "After The Noise Diary: a breathing body woven from fine plexus lines with drifting openings; build-ups erode it into dust, breakdowns re-knit it.",
  "author": "VJ VST",
  "license": "project-internal",
  "engine": {
    "minimumVersion": "0.2.0",
    "shaderProfile": "isf-legacy",
    "workingColorSpace": "linear-srgb",
    "featureContract": "2.0"
  },
  "sourcePolicy": {
    "bass": "kick-or-mix",
    "mid": "snare-or-mix",
    "high": "hat-or-mix",
    "level": "mix"
  },
  "stages": [
    {
      "id": "mesh",
      "kind": "generator",
      "shader": "Instrument/mesh_body.fs",
      "targetFormat": "rgba16f",
      "scale": 1.0,
      "inputs": {},
      "parameters": [
        {
          "name": "turn",
          "label": "Turn",
          "min": -0.3,
          "max": 0.6,
          "default": 0.08,
          "unit": "normalized",
          "cyclic": false,
          "integrate": true
        },
        {
          "name": "breathe",
          "label": "Breathe",
          "min": 0.0,
          "max": 1.5,
          "default": 0.3,
          "unit": "normalized",
          "cyclic": false,
          "integrate": true
        },
        {
          "name": "size",
          "label": "Size",
          "min": 0.3,
          "max": 1.1,
          "default": 0.62,
          "unit": "normalized",
          "cyclic": false
        },
        {
          "name": "density",
          "label": "Density",
          "min": 5,
          "max": 22,
          "default": 11,
          "unit": "normalized",
          "cyclic": false
        },
        {
          "name": "erosion",
          "label": "Erosion",
          "min": 0,
          "max": 1,
          "default": 0.12,
          "unit": "normalized",
          "cyclic": false
        },
        {
          "name": "hole",
          "label": "Hole",
          "min": 0,
          "max": 1,
          "default": 0.5,
          "unit": "normalized",
          "cyclic": false
