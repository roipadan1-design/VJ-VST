{
  "schemaVersion": "2.0",
  "id": "mesh-body",
  "name": "Mesh Body",
  "description": "After The Noise Diary: a breathing body woven from fine plexus lines with drifting openings; accents swell it, build-ups erode it into dust, the drop re-knits it.",
  "author": "VJ VST",
  "license": "project-internal",
  "engine": {
    "minimumVersion": "0.2.0",
    "shaderProfile": "isf-legacy",
    "workingColorSpace": "linear-srgb",
    "featureContract": "2.0"
  },
  "sourcePolicy": {
    "bass": "kick-or-mix",
    "mid": "snare-or-mix",
    "high": "hat-or-mix",
    "level": "mix"
  },
  "stages": [
    {
      "id": "mesh",
      "kind": "generator",
      "shader": "Instrument/mesh_body.fs",
      "targetFormat": "rgba16f",
      "scale": 1.0,
      "inputs": {},
