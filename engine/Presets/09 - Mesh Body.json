        {
          "name": "turn",
          "label": "Turn",
          "min": 0.0,
          "max": 0.4,
          "default": 0.08,
          "unit": "normalized",
          "cyclic": false,
          "integrate": true
        },
        {
          "name": "breathe",
          "label": "Breathe",
          "min": 0.0,
          "max": 1.5,
          "default": 0.3,
          "unit": "normalized",
          "cyclic": false,
          "integrate": true
        },
        {
          "name": "size",
          "label": "Size",
          "min": 0.3,
          "max": 1.1,
          "default": 0.62,
          "unit": "normalized",
          "cyclic": false
        },
        {
          "name": "density",
          "label": "Density",
          "min": 5,
          "max": 22,
          "default": 11,
          "unit": "normalized",
          "cyclic": false
        },
        {
          "name": "erosion",
          "label": "Erosion",
          "min": 0,
          "max": 1,
          "default": 0.12,
          "unit": "normalized",
          "cyclic": false
        },
        {
          "name": "hole",
          "label": "Hole",
          "min": 0,
          "max": 1,
          "default": 0.75,
          "unit": "normalized",
          "cyclic": false
        },
        {
          "name": "surge",
          "label": "Surge",
          "min": 0,
          "max": 3.0,
          "default": 0,
          "unit": "normalized",
          "cyclic": false
        },
        {
          "name": "emission",
          "label": "Emission",
          "min": 0.2,
          "max": 4.0,
          "default": 1.2,
          "unit": "normalized",
          "cyclic": false
        }
      ]
    }
  ],
  "macros": [
    {
      "id": "intensity",
      "slot": 0,
      "label": "glow",
      "default": 0.5
    },
    {
      "id": "speed",
      "slot": 1,
      "label": "Speed",
      "default": 0.5
    },
    {
      "id": "form",
      "slot": 2,
      "label": "opening",
      "default": 0.5
    },
    {
      "id": "scale",
      "slot": 3,
      "label": "size",
      "default": 0.5
    },
    {
      "id": "react",
      "slot": 4,
      "label": "React",
      "default": 0.5
    },
    {
      "id": "erode",
      "slot": 5,
      "label": "erosion",
      "default": 0.5
    },
    {
      "id": "glide",
      "slot": 6,
      "label": "Glide",
      "default": 0.25
    },
    {
      "id": "detail",
      "slot": 7,
      "label": "mesh",
      "default": 0.5
    }
