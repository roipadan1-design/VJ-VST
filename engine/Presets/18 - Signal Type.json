{
  "schemaVersion": "2.0",
  "id": "signal-type",
  "name": "Signal Type",
  "description": "Chunky extruded words over angular duotone shards, a new word every beat, smeared and split on kicks.",
  "author": "VJ VST",
  "license": "project-internal",
  "engine": {
    "minimumVersion": "0.2.0",
    "shaderProfile": "isf-legacy",
    "workingColorSpace": "linear-srgb",
    "featureContract": "2.0"
  },
  "sourcePolicy": {
    "bass": "kick-or-mix",
    "mid": "snare-or-mix",
    "high": "hat-or-mix",
    "level": "mix"
  },
  "stages": [
    {
      "id": "type",
      "kind": "generator",
      "shader": "Instrument/extruded_type.fs",
      "targetFormat": "rgba16f",
      "scale": 1.0,
      "inputs": {},
      "parameters": [
        {
          "name": "depth",
          "label": "Depth",
          "min": 0,
          "max": 0.35,
          "default": 0.12,
          "unit": "normalized",
          "cyclic": false
        },
        {
          "name": "angle",
          "label": "Angle",
          "min": -3.14,
          "max": 3.14,
          "default": -0.6,
          "unit": "normalized",
          "cyclic": false
        },
        {
          "name": "zoom",
          "label": "Zoom",
          "min": 0.6,
          "max": 2.2,
          "default": 1.1,
          "unit": "normalized",
          "cyclic": false
        },
        {
          "name": "smear",
          "label": "Smear",
          "min": 0,
          "max": 1,
          "default": 0,
          "unit": "normalized",
          "cyclic": false
        },
        {
          "name": "aberration",
          "label": "Aberration",
          "min": 0,
          "max": 0.03,
          "default": 0.004,
          "unit": "normalized",
          "cyclic": false
        },
        {
          "name": "hue",
          "label": "Hue",
          "min": 0,
          "max": 1,
          "default": 0.15,
          "unit": "normalized",
          "cyclic": true
        },
        {
          "name": "background",
          "label": "Background",
          "min": 0,
          "max": 1,
          "default": 0.6,
          "unit": "normalized",
          "cyclic": false
        },
        {
          "name": "wobble",
          "label": "Wobble",
          "min": 0.0,
          "max": 1.5,
          "default": 0.3,
          "unit": "normalized",
          "cyclic": false,
          "integrate": true
        },
        {
          "name": "emission",
          "label": "Emission",
          "min": 0.3,
          "max": 3.5,
          "default": 1.3,
          "unit": "normalized",
          "cyclic": false
        }
      ],
      "sources": {
        "word": {
          "type": "text",
          "words": [
            "VOLT",
            "NERVE",
            "SIGNAL",
            "ECHO",
            "NULL"
          ],
          "font": "Arial Black",
          "advance": "beat",
          "every": 1,
          "order": "sequence"
        }
      }
    }
  ],
  "macros": [
    {
      "id": "intensity",
      "slot": 0,
      "label": "Intensity",
      "default": 0.5
    },
    {
      "id": "motion",
      "slot": 1,
      "label": "Motion",
      "default": 0.4
    },
    {
      "id": "color",
      "slot": 2,
      "label": "Color",
      "default": 0.5
    },
    {
      "id": "space",
      "slot": 3,
      "label": "Space",
      "default": 0.5
    }
  ],
  "modulators": [
    {
      "id": "kick",
      "type": "ad",
      "attackMs": 3,
      "decayMs": 180,
      "peak": 1,
      "retrigger": "max"
    },
    {
      "id": "snare",
      "type": "ad",
      "attackMs": 2,
      "decayMs": 140,
      "peak": 1,
      "retrigger": "restart"
    },
    {
      "id": "hat",
      "type": "ad",
      "attackMs": 1,
      "decayMs": 70,
      "peak": 1,
      "retrigger": "restart"
    },
    {
      "id": "drift",
      "type": "lfo",
      "shape": "sine",
      "periodBeats": 16,
      "phaseOffset": 0,
      "polarity": "bipolar"
    }
  ],
  "routes": [
    {
      "id": "macro-intensity-type-depth",
      "source": "macro.intensity",
      "destination": "stage.type.depth",
      "inputMin": 0.0,
      "inputMax": 1.0,
      "curve": "linear",
      "exponent": 1.0,
      "center": 0.5,
      "amount": 0.6,
      "attackMs": 20,
      "releaseMs": 180
    },
    {
      "id": "macro-intensity-type-emission",
      "source": "macro.intensity",
      "destination": "stage.type.emission",
      "inputMin": 0.0,
      "inputMax": 1.0,
      "curve": "linear",
      "exponent": 1.0,
      "center": 0.5,
      "amount": 0.3,
      "attackMs": 20,
      "releaseMs": 180
    },
    {
      "id": "macro-motion-type-wobble",
      "source": "macro.motion",
      "destination": "stage.type.wobble",
      "inputMin": 0.0,
      "inputMax": 1.0,
      "curve": "linear",
      "exponent": 1.0,
      "center": 0.4,
      "amount": 0.8,
      "attackMs": 20,
      "releaseMs": 180
    },
    {
      "id": "macro-color-type-hue",
      "source": "macro.color",
      "destination": "stage.type.hue",
      "inputMin": 0.0,
      "inputMax": 1.0,
      "curve": "linear",
      "exponent": 1.0,
      "center": 0.5,
      "amount": 1.0,
      "attackMs": 20,
      "releaseMs": 180
    },
    {
      "id": "macro-space-type-zoom",
      "source": "macro.space",
      "destination": "stage.type.zoom",
      "inputMin": 0.0,
      "inputMax": 1.0,
      "curve": "linear",
      "exponent": 1.0,
      "center": 0.5,
      "amount": 0.7,
      "attackMs": 20,
      "releaseMs": 180
    },
    {
      "id": "macro-space-type-background",
      "source": "macro.space",
      "destination": "stage.type.background",
      "inputMin": 0.0,
      "inputMax": 1.0,
      "curve": "linear",
      "exponent": 1.0,
      "center": 0.5,
      "amount": 0.6,
      "attackMs": 20,
      "releaseMs": 180
    },
    {
      "id": "env-kick-type-smear",
      "source": "env.kick",
      "destination": "stage.type.smear",
      "inputMin": 0.0,
      "inputMax": 1.0,
      "curve": "linear",
      "exponent": 1.0,
      "center": 0.0,
      "amount": 1.0,
      "attackMs": 0,
      "releaseMs": 0
    },
    {
      "id": "env-snare-type-aberration",
      "source": "env.snare",
      "destination": "stage.type.aberration",
      "inputMin": 0.0,
      "inputMax": 1.0,
      "curve": "linear",
      "exponent": 1.0,
      "center": 0.0,
      "amount": 0.6,
      "attackMs": 0,
      "releaseMs": 0
    },
    {
      "id": "lfo-drift-type-angle",
      "source": "lfo.drift",
      "destination": "stage.type.angle",
      "inputMin": 0.0,
      "inputMax": 1.0,
      "curve": "linear",
      "exponent": 1.0,
      "center": 0.5,
      "amount": 0.12,
      "attackMs": 0,
      "releaseMs": 0
    }
  ],
  "triggers": [
    {
      "id": "kick",
      "on": "event.kick",
      "minStrength": 0.1,
      "refractoryMs": 90,
      "quantize": "none",
      "actions": [
        {
          "type": "envelope",
          "target": "kick",
          "amount": 1
        }
      ]
    },
    {
      "id": "snare",
      "on": "event.snare",
      "minStrength": 0.1,
      "refractoryMs": 70,
      "quantize": "none",
      "actions": [
        {
          "type": "envelope",
          "target": "snare",
          "amount": 1
        }
      ]
    },
    {
      "id": "hat",
      "on": "event.hat",
      "minStrength": 0.1,
      "refractoryMs": 45,
      "quantize": "none",
      "actions": [
        {
          "type": "envelope",
          "target": "hat",
          "amount": 1
        }
      ]
    },
    {
      "id": "user",
      "on": "event.userTrigger",
      "minStrength": 0,
      "refractoryMs": 50,
      "quantize": "none",
      "actions": [
        {
          "type": "envelope",
          "target": "kick",
          "amount": 1
        }
      ]
    }
  ],
  "transition": {
    "type": "cut",
    "durationMs": 0,
    "quantize": "bar",
    "historyOnEnter": "reset",
    "retarget": "snapshot-current"
  },
  "post": {
    "bloom": {
      "enabled": true,
      "amount": 0.25,
      "threshold": 0.9,
      "levels": 5
    },
    "toneMap": "reinhard",
    "exposureEv": 0.3,
    "outputColorSpace": "srgb",
    "grain": 0.025,
    "vignette": 0.2
  },
  "performance": {
    "qualityTier": "medium",
    "sceneBudgetMs1080p": 3.0,
    "deterministicSeed": 909,
    "notes": "target, not measured"
  }
}
