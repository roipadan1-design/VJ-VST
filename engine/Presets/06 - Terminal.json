{
  "schemaVersion": "2.0",
  "id": "terminal",
  "name": "Terminal",
  "description": "An invented machine script scrolling over dark blots; kicks jump the scroll, snares invert a band.",
  "author": "VJ VST",
  "license": "project-internal",
  "engine": {
    "minimumVersion": "0.2.0",
    "shaderProfile": "isf-legacy",
    "workingColorSpace": "linear-srgb",
    "featureContract": "2.0"
  },
  "sourcePolicy": {
    "bass": "kick-or-mix",
    "mid": "snare-or-mix",
    "high": "hat-or-mix",
    "level": "mix"
  },
  "stages": [
    {
      "id": "term",
      "kind": "generator",
      "shader": "Instrument/terminal.fs",
      "targetFormat": "rgba16f",
      "scale": 1.0,
      "inputs": {},
      "parameters": [
        {
          "name": "scroll",
          "label": "Scroll",
          "min": 0.0,
          "max": 6.0,
          "default": 1.0,
          "unit": "normalized",
          "cyclic": false,
          "integrate": true
        },
        {
          "name": "rows",
          "label": "Rows",
          "min": 10,
          "max": 60,
          "default": 26,
          "unit": "normalized",
          "cyclic": false
        },
        {
          "name": "fill",
          "label": "Fill",
          "min": 0,
          "max": 1,
          "default": 0.6,
          "unit": "normalized",
          "cyclic": false
        },
        {
          "name": "jump",
          "label": "Jump",
          "min": 0,
          "max": 1,
          "default": 0,
          "unit": "normalized",
          "cyclic": false
        },
        {
          "name": "invert",
          "label": "Invert",
          "min": 0,
          "max": 1,
          "default": 0,
          "unit": "normalized",
          "cyclic": false
        },
        {
          "name": "background",
          "label": "Background",
          "min": 0,
          "max": 1,
          "default": 0.5,
          "unit": "normalized",
          "cyclic": false
        },
        {
          "name": "morph",
          "label": "Morph",
          "min": 0.0,
          "max": 1.0,
          "default": 0.2,
          "unit": "normalized",
          "cyclic": false,
          "integrate": true
        },
        {
          "name": "emission",
          "label": "Emission",
          "min": 0.2,
          "max": 4.0,
          "default": 1.3,
          "unit": "normalized",
          "cyclic": false
        },
        {
          "name": "decay",
          "label": "Decay",
          "min": 0,
          "max": 1,
          "default": 0.1,
          "unit": "normalized",
          "cyclic": false
        }
      ]
    }
  ],
  "macros": [
    {
      "id": "intensity",
      "slot": 0,
      "label": "glow",
      "default": 0.5
    },
    {
      "id": "speed",
      "slot": 1,
      "label": "Speed",
      "default": 0.5
    },
    {
      "id": "form",
      "slot": 2,
      "label": "blots",
      "default": 0.5
    },
    {
      "id": "scale",
      "slot": 3,
      "label": "text size",
      "default": 0.5
    },
    {
      "id": "impact",
      "slot": 4,
      "label": "Impact",
      "default": 0.4
    },
    {
      "id": "erode",
      "slot": 5,
      "label": "dropout",
      "default": 0.5
    },
    {
      "id": "glide",
      "slot": 6,
      "label": "Glide",
      "default": 0.25
    },
    {
      "id": "detail",
      "slot": 7,
      "label": "density",
      "default": 0.5
    }
  ],
  "modulators": [
    {
      "id": "kick",
      "type": "ad",
      "attackMs": 3,
      "decayMs": 250,
      "peak": 1,
      "retrigger": "max"
    },
    {
      "id": "snare",
      "type": "ad",
      "attackMs": 2,
      "decayMs": 200,
      "peak": 1,
      "retrigger": "restart"
    },
    {
      "id": "hat",
      "type": "ad",
      "attackMs": 1,
      "decayMs": 110,
      "peak": 1,
      "retrigger": "restart"
    },
    {
      "id": "swell",
      "type": "ad",
      "attackMs": 5,
      "decayMs": 900,
      "peak": 1,
      "retrigger": "max"
    },
    {
      "id": "drop",
      "type": "ad",
      "attackMs": 1,
      "decayMs": 80,
      "peak": 1,
      "retrigger": "restart"
    },
    {
      "id": "phrase",
      "type": "lfo",
      "shape": "sine",
      "periodBeats": 64,
      "phaseOffset": 0,
      "polarity": "bipolar"
    }
  ],
  "routes": [
    {
      "id": "macro-intensity-term-emission",
      "source": "macro.intensity",
      "destination": "stage.term.emission",
      "inputMin": 0.0,
      "inputMax": 1.0,
      "curve": "linear",
      "exponent": 1.0,
      "center": 0.5,
      "amount": 0.6,
      "attackMs": 60,
      "releaseMs": 60
    },
    {
      "id": "macro-form-term-background",
      "source": "macro.form",
      "destination": "stage.term.background",
      "inputMin": 0.0,
      "inputMax": 1.0,
      "curve": "linear",
      "exponent": 1.0,
      "center": 0.5,
      "amount": 0.9,
      "attackMs": 60,
      "releaseMs": 60
    },
    {
      "id": "macro-scale-term-rows",
      "source": "macro.scale",
      "destination": "stage.term.rows",
      "inputMin": 0.0,
      "inputMax": 1.0,
      "curve": "linear",
      "exponent": 1.0,
      "center": 0.5,
      "amount": -0.8,
      "attackMs": 60,
      "releaseMs": 60
    },
    {
      "id": "macro-erode-term-decay",
      "source": "macro.erode",
      "destination": "stage.term.decay",
      "inputMin": 0.0,
      "inputMax": 1.0,
      "curve": "linear",
      "exponent": 1.0,
      "center": 0.5,
      "amount": 0.8,
      "attackMs": 60,
      "releaseMs": 60
    },
    {
      "id": "macro-detail-term-fill",
      "source": "macro.detail",
      "destination": "stage.term.fill",
      "inputMin": 0.0,
      "inputMax": 1.0,
      "curve": "linear",
      "exponent": 1.0,
      "center": 0.5,
      "amount": 1.0,
      "attackMs": 60,
      "releaseMs": 60
    },
    {
      "id": "env-kick-term-jump",
      "source": "env.kick",
      "destination": "stage.term.jump",
      "inputMin": 0.0,
      "inputMax": 1.0,
      "curve": "linear",
      "exponent": 1.0,
      "center": 0.0,
      "amount": 1.0,
      "attackMs": 0,
      "releaseMs": 0,
      "scaleBy": "macro.impact"
    },
    {
      "id": "env-snare-term-invert",
      "source": "env.snare",
      "destination": "stage.term.invert",
      "inputMin": 0.0,
      "inputMax": 1.0,
      "curve": "linear",
      "exponent": 1.0,
      "center": 0.0,
      "amount": 1.0,
      "attackMs": 0,
      "releaseMs": 0,
      "scaleBy": "macro.impact"
    },
    {
      "id": "audio-high-activity-term-fill",
      "source": "audio.high.activity",
      "destination": "stage.term.fill",
      "inputMin": 0.0,
      "inputMax": 1.0,
      "curve": "linear",
      "exponent": 1.0,
      "center": 0.0,
      "amount": 0.2,
      "attackMs": 12,
      "releaseMs": 250
    },
    {
      "id": "descriptor-build-term-background",
      "source": "descriptor.build",
      "destination": "stage.term.background",
      "inputMin": 0.0,
      "inputMax": 1.0,
      "curve": "linear",
      "exponent": 1.0,
      "center": 0.0,
      "amount": 0.3,
      "attackMs": 120,
      "releaseMs": 400
    }
  ],
  "triggers": [
    {
      "id": "kick",
      "on": "event.kick",
      "minStrength": 0.1,
      "refractoryMs": 90,
      "quantize": "none",
      "actions": [
        {
          "type": "envelope",
          "target": "kick",
          "amount": 1
        },
        {
          "type": "envelope",
          "target": "swell",
          "amount": 1
        },
        {
          "type": "envelope",
          "target": "drop",
          "amount": 1
        }
      ]
    },
    {
      "id": "snare",
      "on": "event.snare",
      "minStrength": 0.1,
      "refractoryMs": 70,
      "quantize": "none",
      "actions": [
        {
          "type": "envelope",
          "target": "snare",
          "amount": 1
        }
      ]
    },
    {
      "id": "hat",
      "on": "event.hat",
      "minStrength": 0.1,
      "refractoryMs": 45,
      "quantize": "none",
      "actions": [
        {
          "type": "envelope",
          "target": "hat",
          "amount": 1
        }
      ]
    },
    {
      "id": "user",
      "on": "event.userTrigger",
      "minStrength": 0,
      "refractoryMs": 50,
      "quantize": "none",
      "actions": [
        {
          "type": "envelope",
          "target": "kick",
          "amount": 1
        },
        {
          "type": "envelope",
          "target": "swell",
          "amount": 1
        },
        {
          "type": "envelope",
          "target": "drop",
          "amount": 1
        }
      ]
    }
  ],
  "transition": {
    "type": "cut",
    "durationMs": 0,
    "quantize": "beat",
    "historyOnEnter": "reset",
    "retarget": "snapshot-current"
  },
  "post": {
    "bloom": {
      "enabled": true,
      "amount": 0.15,
      "threshold": 1.0,
      "levels": 4
    },
    "toneMap": "reinhard",
    "exposureEv": 0.5,
    "outputColorSpace": "srgb",
    "grain": 0.0,
    "vignette": 0.15
  },
  "performance": {
    "qualityTier": "medium",
    "sceneBudgetMs1080p": 3.0,
    "deterministicSeed": 707,
    "notes": "target, not measured"
  }
}
