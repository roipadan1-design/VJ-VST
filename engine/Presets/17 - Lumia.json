{
  "schemaVersion": "2.0",
  "id": "lumia",
  "name": "Lumia",
  "description": "After Thomas Wilfred's lumia and the aurora: veils of light hang in the dark and fold slowly, brightest where a fold is seen edge-on. The level unfurls them, build-ups bring in a third veil, an accent is a slow swell; in silence they settle toward the horizon. Ambient: try BREATHE, React To kick off, palette Cyanotype or Scene Colors.",
  "author": "VJ VST",
  "license": "project-internal",
  "engine": {
    "minimumVersion": "0.2.0",
    "shaderProfile": "isf-legacy",
    "workingColorSpace": "linear-srgb",
    "featureContract": "2.0"
  },
  "sourcePolicy": {
    "bass": "kick-or-mix",
    "mid": "snare-or-mix",
    "high": "hat-or-mix",
    "level": "mix"
  },
