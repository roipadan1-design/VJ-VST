      "id": "accent",
      "on": "event.accent",
      "minStrength": 0,
      "refractoryMs": 0,
      "quantize": "none",
      "actions": [
        {
          "type": "envelope",
          "target": "hit",
          "amount": 1
        },
        {
          "type": "envelope",
          "target": "pulse",
          "amount": 1
        }
      ]
    },
    {
      "id": "tick",
      "on": "event.tick",
      "minStrength": 0,
      "refractoryMs": 0,
      "quantize": "none",
      "actions": [
        {
          "type": "envelope",
          "target": "hit",
          "amount": 1,
          "scale": "tick"
        }
      ]
    },
    {
      "id": "snare",
      "on": "event.snare",
      "minStrength": 0.1,
