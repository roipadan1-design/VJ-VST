{
  "schemaVersion": "2.0",
  "id": "one-bit",
  "name": "One Bit",
  "description": "Hard 1-bit threshold of abstract 3D forms with halftone edges and speckle; forms swap on every second accent, build-ups close a letterbox, the drop flips it negative.",
  "author": "VJ VST",
  "license": "project-internal",
  "engine": {
    "minimumVersion": "0.2.0",
    "shaderProfile": "isf-legacy",
    "workingColorSpace": "linear-srgb",
    "featureContract": "2.0"
  },
  "sourcePolicy": {
    "bass": "kick-or-mix",
    "mid": "snare-or-mix",
    "high": "hat-or-mix",
    "level": "mix"
  },
  "stages": [
    {
      "id": "bits",
      "kind": "generator",
      "shader": "Instrument/one_bit.fs",
      "targetFormat": "rgba16f",
      "scale": 1.0,
      "inputs": {},
      "parameters": [
        {
          "name": "threshold",
          "label": "Threshold",
          "min": 0.2,
          "max": 0.8,
          "default": 0.45,
          "unit": "normalized",
          "cyclic": false
        },
        {
          "name": "dither",
          "label": "Dither",
          "min": 0,
          "max": 1,
          "default": 0.5,
          "unit": "normalized",
          "cyclic": false
        },
        {
          "name": "cell",
          "label": "Cell",
          "min": 2,
          "max": 14,
          "default": 5,
          "unit": "normalized",
          "cyclic": false
        },
        {
          "name": "zoom",
          "label": "Zoom",
          "min": 0.6,
          "max": 3.2,
          "default": 1.3,
          "unit": "normalized",
          "cyclic": false
        },
        {
          "name": "spin",
          "label": "Spin",
          "min": 0.0,
          "max": 0.6,
          "default": 0.1,
          "unit": "normalized",
          "cyclic": false,
          "integrate": true
        },
        {
          "name": "invert",
          "label": "Invert",
          "min": 0,
          "max": 1,
          "default": 0,
          "unit": "normalized",
          "cyclic": false
        },
        {
          "name": "frame",
          "label": "Frame",
          "min": 0,
          "max": 1,
          "default": 0,
          "unit": "normalized",
          "cyclic": false
        },
        {
          "name": "speckle",
          "label": "Speckle",
          "min": 0,
          "max": 1,
          "default": 0.25,
          "unit": "normalized",
          "cyclic": false
        },
        {
          "name": "surge",
          "label": "Surge",
          "min": 0,
          "max": 1.8,
          "default": 0,
          "unit": "normalized",
          "cyclic": false
        },
        {
          "name": "texture_amt",
          "label": "Texture Amt",
          "min": 0,
          "max": 1,
          "default": 0.5,
          "unit": "normalized",
          "cyclic": false
        }
      ],
      "sources": {
        "source": {
          "type": "images",
          "folder": "Images/Forms",
          "advance": "event.accent",
          "every": 2,
          "order": "random"
        }
      }
    }
  ],
  "macros": [
    {
      "id": "intensity",
      "slot": 0,
      "label": "white",
      "default": 0.5
    },
    {
      "id": "speed",
      "slot": 1,
      "label": "Speed",
      "default": 0.5
    },
    {
      "id": "form",
      "slot": 2,
      "label": "dither",
      "default": 0.5
    },
    {
      "id": "scale",
      "slot": 3,
      "label": "zoom",
      "default": 0.5
    },
    {
      "id": "react",
      "slot": 4,
      "label": "React",
      "default": 0.5
    },
    {
      "id": "erode",
      "slot": 5,
      "label": "speckle",
      "default": 0.5
    },
    {
      "id": "glide",
      "slot": 6,
      "label": "Glide",
      "default": 0.25
    },
    {
      "id": "detail",
      "slot": 7,
      "label": "cell",
      "default": 0.5
    }
  ],
  "modulators": [
    {
      "id": "hit",
      "type": "ad",
      "attackMs": 0,
      "decayMs": 1300,
      "peak": 1,
      "retrigger": "max",
      "style": "hit"
    },
    {
      "id": "snare",
      "type": "ad",
      "attackMs": 2,
      "decayMs": 800,
      "peak": 1,
      "retrigger": "restart",
      "style": "snare"
    },
    {
      "id": "drop",
      "type": "ad",
      "attackMs": 0,
      "decayMs": 4000,
      "peak": 1,
      "retrigger": "max",
      "style": "drop"
    },
    {
      "id": "pulse",
      "type": "ad",
      "attackMs": 1,
      "decayMs": 80,
      "peak": 1,
      "retrigger": "restart"
    },
    {
      "id": "phrase",
      "type": "lfo",
      "shape": "sine",
      "periodBeats": 64,
      "phaseOffset": 0,
      "polarity": "bipolar"
    }
  ],
  "routes": [
