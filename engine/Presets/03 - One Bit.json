{
  "schemaVersion": "2.0",
  "id": "one-bit",
  "name": "One Bit",
  "description": "Hard 1-bit threshold of abstract 3D forms with halftone edges and speckle; forms swap on every second snare, snares flip polarity.",
  "author": "VJ VST",
  "license": "project-internal",
  "engine": {
    "minimumVersion": "0.2.0",
    "shaderProfile": "isf-legacy",
    "workingColorSpace": "linear-srgb",
    "featureContract": "2.0"
  },
  "sourcePolicy": {
    "bass": "kick-or-mix",
    "mid": "snare-or-mix",
    "high": "hat-or-mix",
    "level": "mix"
  },
  "stages": [
    {
      "id": "bits",
      "kind": "generator",
      "shader": "Instrument/one_bit.fs",
      "targetFormat": "rgba16f",
      "scale": 1.0,
      "inputs": {},
      "parameters": [
        {
          "name": "threshold",
          "label": "Threshold",
          "min": 0.2,
          "max": 0.8,
          "default": 0.45,
          "unit": "normalized",
          "cyclic": false
        },
        {
          "name": "dither",
          "label": "Dither",
          "min": 0,
          "max": 1,
          "default": 0.5,
          "unit": "normalized",
          "cyclic": false
        },
        {
          "name": "cell",
          "label": "Cell",
          "min": 2,
          "max": 14,
          "default": 5,
          "unit": "normalized",
          "cyclic": false
        },
        {
          "name": "zoom",
          "label": "Zoom",
          "min": 0.6,
          "max": 3.2,
          "default": 1.3,
          "unit": "normalized",
          "cyclic": false
        },
        {
          "name": "spin",
          "label": "Spin",
          "min": 0.0,
          "max": 0.6,
          "default": 0.1,
          "unit": "normalized",
          "cyclic": false,
          "integrate": true
        },
        {
          "name": "invert",
          "label": "Invert",
          "min": 0,
          "max": 1,
          "default": 0,
          "unit": "normalized",
          "cyclic": false
        },
        {
          "name": "frame",
          "label": "Frame",
          "min": 0,
          "max": 1,
          "default": 0,
          "unit": "normalized",
          "cyclic": false
        },
        {
          "name": "speckle",
          "label": "Speckle",
          "min": 0,
          "max": 1,
          "default": 0.25,
          "unit": "normalized",
          "cyclic": false
        },
        {
          "name": "surge",
          "label": "Surge",
          "min": 0,
          "max": 1,
          "default": 0,
          "unit": "normalized",
          "cyclic": false
        },
        {
          "name": "texture_amt",
          "label": "Texture Amt",
          "min": 0,
          "max": 1,
          "default": 0.5,
          "unit": "normalized",
          "cyclic": false
        }
      ],
      "sources": {
        "source": {
          "type": "images",
          "folder": "Images/Forms",
          "advance": "event.snare",
          "every": 2,
          "order": "random"
        }
      }
    }
  ],
  "macros": [
    {
      "id": "intensity",
      "slot": 0,
      "label": "white",
      "default": 0.5
    },
    {
      "id": "speed",
      "slot": 1,
      "label": "Speed",
      "default": 0.5
    },
    {
      "id": "form",
      "slot": 2,
      "label": "dither",
      "default": 0.5
    },
    {
      "id": "scale",
      "slot": 3,
      "label": "zoom",
      "default": 0.5
    },
    {
      "id": "impact",
      "slot": 4,
      "label": "Impact",
      "default": 0.4
    },
    {
      "id": "erode",
      "slot": 5,
      "label": "speckle",
      "default": 0.5
    },
    {
      "id": "glide",
      "slot": 6,
      "label": "Glide",
      "default": 0.25
    },
    {
      "id": "detail",
      "slot": 7,
      "label": "cell",
      "default": 0.5
    }
  ],
  "modulators": [
    {
      "id": "kick",
      "type": "ad",
      "attackMs": 3,
      "decayMs": 250,
      "peak": 1,
      "retrigger": "max"
    },
    {
      "id": "snare",
      "type": "ad",
      "attackMs": 2,
      "decayMs": 200,
      "peak": 1,
      "retrigger": "restart"
    },
    {
      "id": "hat",
      "type": "ad",
      "attackMs": 1,
      "decayMs": 110,
      "peak": 1,
      "retrigger": "restart"
    },
    {
      "id": "swell",
      "type": "ad",
      "attackMs": 5,
      "decayMs": 900,
      "peak": 1,
      "retrigger": "max"
    },
    {
      "id": "drop",
      "type": "ad",
      "attackMs": 1,
      "decayMs": 80,
      "peak": 1,
      "retrigger": "restart"
    },
    {
      "id": "phrase",
      "type": "lfo",
      "shape": "sine",
      "periodBeats": 64,
      "phaseOffset": 0,
      "polarity": "bipolar"
    }
  ],
  "routes": [
    {
      "id": "macro-intensity-bits-threshold",
      "source": "macro.intensity",
      "destination": "stage.bits.threshold",
      "inputMin": 0.0,
      "inputMax": 1.0,
      "curve": "linear",
      "exponent": 1.0,
      "center": 0.5,
      "amount": -0.4,
      "attackMs": 60,
      "releaseMs": 60
    },
    {
      "id": "macro-intensity-bits-texture_amt",
      "source": "macro.intensity",
      "destination": "stage.bits.texture_amt",
      "inputMin": 0.0,
      "inputMax": 1.0,
      "curve": "linear",
      "exponent": 1.0,
      "center": 0.5,
      "amount": 0.3,
      "attackMs": 60,
      "releaseMs": 60
    },
    {
      "id": "macro-form-bits-dither",
      "source": "macro.form",
      "destination": "stage.bits.dither",
      "inputMin": 0.0,
      "inputMax": 1.0,
      "curve": "linear",
      "exponent": 1.0,
      "center": 0.5,
      "amount": 0.8,
      "attackMs": 60,
      "releaseMs": 60
    },
    {
      "id": "macro-scale-bits-zoom",
      "source": "macro.scale",
      "destination": "stage.bits.zoom",
      "inputMin": 0.0,
      "inputMax": 1.0,
      "curve": "linear",
      "exponent": 1.0,
      "center": 0.5,
      "amount": -0.8,
      "attackMs": 60,
      "releaseMs": 60
    },
    {
      "id": "macro-erode-bits-speckle",
      "source": "macro.erode",
      "destination": "stage.bits.speckle",
      "inputMin": 0.0,
      "inputMax": 1.0,
      "curve": "linear",
      "exponent": 1.0,
      "center": 0.5,
      "amount": 0.8,
      "attackMs": 60,
      "releaseMs": 60
    },
    {
      "id": "macro-detail-bits-cell",
      "source": "macro.detail",
      "destination": "stage.bits.cell",
      "inputMin": 0.0,
      "inputMax": 1.0,
      "curve": "linear",
      "exponent": 1.0,
      "center": 0.5,
      "amount": -0.8,
      "attackMs": 60,
      "releaseMs": 60
    },
    {
      "id": "env-kick-bits-surge",
      "source": "env.kick",
      "destination": "stage.bits.surge",
      "inputMin": 0.0,
      "inputMax": 1.0,
      "curve": "linear",
      "exponent": 1.0,
      "center": 0.0,
      "amount": 1.0,
      "attackMs": 0,
      "releaseMs": 0,
      "scaleBy": "macro.impact"
    },
    {
      "id": "env-snare-bits-invert",
      "source": "env.snare",
      "destination": "stage.bits.invert",
      "inputMin": 0.0,
      "inputMax": 1.0,
      "curve": "linear",
      "exponent": 1.0,
      "center": 0.0,
      "amount": 1.0,
      "attackMs": 0,
      "releaseMs": 0,
      "scaleBy": "macro.impact"
    },
    {
      "id": "audio-high-activity-bits-speckle",
      "source": "audio.high.activity",
      "destination": "stage.bits.speckle",
      "inputMin": 0.0,
      "inputMax": 1.0,
      "curve": "linear",
      "exponent": 1.0,
      "center": 0.0,
      "amount": 0.3,
      "attackMs": 12,
      "releaseMs": 250
    },
    {
      "id": "descriptor-centroid-bits-threshold",
      "source": "descriptor.centroid",
      "destination": "stage.bits.threshold",
      "inputMin": 0.0,
      "inputMax": 1.0,
      "curve": "linear",
      "exponent": 1.0,
      "center": 0.5,
      "amount": -0.2,
      "attackMs": 120,
      "releaseMs": 400
    },
    {
      "id": "descriptor-build-bits-texture_amt",
      "source": "descriptor.build",
      "destination": "stage.bits.texture_amt",
      "inputMin": 0.0,
      "inputMax": 1.0,
      "curve": "linear",
      "exponent": 1.0,
      "center": 0.0,
      "amount": 0.3,
      "attackMs": 120,
      "releaseMs": 400
    }
  ],
  "triggers": [
    {
      "id": "kick",
      "on": "event.kick",
      "minStrength": 0.1,
      "refractoryMs": 90,
      "quantize": "none",
      "actions": [
        {
          "type": "envelope",
          "target": "kick",
          "amount": 1
        },
        {
          "type": "envelope",
          "target": "swell",
          "amount": 1
        },
        {
          "type": "envelope",
          "target": "drop",
          "amount": 1
        }
      ]
    },
    {
      "id": "snare",
      "on": "event.snare",
      "minStrength": 0.1,
      "refractoryMs": 70,
      "quantize": "none",
      "actions": [
        {
          "type": "envelope",
          "target": "snare",
          "amount": 1
        }
      ]
    },
    {
      "id": "hat",
      "on": "event.hat",
      "minStrength": 0.1,
      "refractoryMs": 45,
      "quantize": "none",
      "actions": [
        {
          "type": "envelope",
          "target": "hat",
          "amount": 1
        }
      ]
    },
    {
      "id": "user",
      "on": "event.userTrigger",
      "minStrength": 0,
      "refractoryMs": 50,
      "quantize": "none",
      "actions": [
        {
          "type": "envelope",
          "target": "kick",
          "amount": 1
        },
        {
          "type": "envelope",
          "target": "swell",
          "amount": 1
        },
        {
          "type": "envelope",
          "target": "drop",
          "amount": 1
        }
      ]
    }
  ],
  "transition": {
    "type": "cut",
    "durationMs": 0,
    "quantize": "beat",
    "historyOnEnter": "reset",
    "retarget": "snapshot-current"
  },
  "post": {
    "bloom": {
      "enabled": true,
      "amount": 0.22,
      "threshold": 0.9,
      "levels": 5
    },
    "toneMap": "reinhard",
    "exposureEv": 0.3,
    "outputColorSpace": "srgb",
    "grain": 0.0,
    "vignette": 0.25
  },
  "performance": {
    "qualityTier": "medium",
    "sceneBudgetMs1080p": 3.0,
    "deterministicSeed": 404,
    "notes": "target, not measured"
  }
}
