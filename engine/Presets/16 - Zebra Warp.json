{
  "schemaVersion": "2.0",
  "id": "zebra-warp",
  "name": "Zebra Warp",
  "description": "Op-art stripes bent by a flowing field over a violet-cyan gradient, stepped bars jump in on kicks.",
  "author": "VJ VST",
  "license": "project-internal",
  "engine": {
    "minimumVersion": "0.2.0",
    "shaderProfile": "isf-legacy",
    "workingColorSpace": "linear-srgb",
    "featureContract": "2.0"
  },
  "sourcePolicy": {
    "bass": "kick-or-mix",
    "mid": "snare-or-mix",
    "high": "hat-or-mix",
    "level": "mix"
  },
  "stages": [
    {
      "id": "zebra",
      "kind": "generator",
      "shader": "Instrument/zebra_warp.fs",
      "targetFormat": "rgba16f",
      "scale": 1.0,
      "inputs": {},
      "parameters": [
        {
          "name": "stripes",
          "label": "Stripes",
          "min": 4,
          "max": 40,
          "default": 14,
          "unit": "normalized",
          "cyclic": false
        },
        {
          "name": "warp",
          "label": "Warp",
          "min": 0,
          "max": 4,
          "default": 1.4,
          "unit": "normalized",
          "cyclic": false
        },
        {
          "name": "flow",
          "label": "Flow",
          "min": 0.0,
          "max": 1.0,
          "default": 0.18,
          "unit": "normalized",
          "cyclic": false,
          "integrate": true
        },
        {
          "name": "band",
          "label": "Band",
          "min": 0.1,
          "max": 1.0,
          "default": 0.35,
          "unit": "normalized",
          "cyclic": false
        },
        {
          "name": "bars",
          "label": "Bars",
          "min": 0,
          "max": 1,
          "default": 0,
          "unit": "normalized",
          "cyclic": false
        },
        {
          "name": "hue",
          "label": "Hue",
          "min": 0,
          "max": 1,
          "default": 0,
          "unit": "normalized",
          "cyclic": true
        },
        {
          "name": "emission",
          "label": "Emission",
          "min": 0.3,
          "max": 3.5,
          "default": 1.2,
          "unit": "normalized",
          "cyclic": false
        },
        {
          "name": "twist",
          "label": "Twist",
          "min": 0,
          "max": 1,
          "default": 0,
          "unit": "normalized",
          "cyclic": false
        }
      ]
    }
  ],
  "macros": [
    {
      "id": "intensity",
      "slot": 0,
      "label": "Intensity",
      "default": 0.5
    },
    {
      "id": "motion",
      "slot": 1,
      "label": "Motion",
      "default": 0.4
    },
    {
      "id": "color",
      "slot": 2,
      "label": "Color",
      "default": 0.5
    },
    {
      "id": "space",
      "slot": 3,
      "label": "Space",
      "default": 0.5
    }
  ],
  "modulators": [
    {
      "id": "kick",
      "type": "ad",
      "attackMs": 3,
      "decayMs": 180,
      "peak": 1,
      "retrigger": "max"
    },
    {
      "id": "snare",
      "type": "ad",
      "attackMs": 2,
      "decayMs": 140,
      "peak": 1,
      "retrigger": "restart"
    },
    {
      "id": "hat",
      "type": "ad",
      "attackMs": 1,
      "decayMs": 70,
      "peak": 1,
      "retrigger": "restart"
    },
    {
      "id": "drift",
      "type": "lfo",
      "shape": "sine",
      "periodBeats": 16,
      "phaseOffset": 0,
      "polarity": "bipolar"
    }
  ],
  "routes": [
    {
      "id": "macro-intensity-zebra-emission",
      "source": "macro.intensity",
      "destination": "stage.zebra.emission",
      "inputMin": 0.0,
      "inputMax": 1.0,
      "curve": "linear",
      "exponent": 1.0,
      "center": 0.5,
      "amount": 0.5,
      "attackMs": 20,
      "releaseMs": 180
    },
    {
      "id": "macro-intensity-zebra-stripes",
      "source": "macro.intensity",
      "destination": "stage.zebra.stripes",
      "inputMin": 0.0,
      "inputMax": 1.0,
      "curve": "linear",
      "exponent": 1.0,
      "center": 0.5,
      "amount": 0.4,
      "attackMs": 20,
      "releaseMs": 180
    },
    {
      "id": "macro-motion-zebra-flow",
      "source": "macro.motion",
      "destination": "stage.zebra.flow",
      "inputMin": 0.0,
      "inputMax": 1.0,
      "curve": "linear",
      "exponent": 1.0,
      "center": 0.4,
      "amount": 0.9,
      "attackMs": 20,
      "releaseMs": 180
    },
    {
      "id": "macro-color-zebra-hue",
      "source": "macro.color",
      "destination": "stage.zebra.hue",
      "inputMin": 0.0,
      "inputMax": 1.0,
      "curve": "linear",
      "exponent": 1.0,
      "center": 0.5,
      "amount": 1.0,
      "attackMs": 20,
      "releaseMs": 180
    },
    {
      "id": "macro-space-zebra-band",
      "source": "macro.space",
      "destination": "stage.zebra.band",
      "inputMin": 0.0,
      "inputMax": 1.0,
      "curve": "linear",
      "exponent": 1.0,
      "center": 0.5,
      "amount": 0.8,
      "attackMs": 20,
      "releaseMs": 180
    },
    {
      "id": "env-kick-zebra-bars",
      "source": "env.kick",
      "destination": "stage.zebra.bars",
      "inputMin": 0.0,
      "inputMax": 1.0,
      "curve": "linear",
      "exponent": 1.0,
      "center": 0.0,
      "amount": 1.0,
      "attackMs": 0,
      "releaseMs": 0
    },
    {
      "id": "audio-bass-activity-zebra-warp",
      "source": "audio.bass.activity",
      "destination": "stage.zebra.warp",
      "inputMin": 0.0,
      "inputMax": 1.0,
      "curve": "linear",
      "exponent": 1.0,
      "center": 0.0,
      "amount": 0.25,
      "attackMs": 30,
      "releaseMs": 220
    },
    {
      "id": "descriptor-energytrend-zebra-twist",
      "source": "descriptor.energyTrend",
      "destination": "stage.zebra.twist",
      "inputMin": 0.0,
      "inputMax": 1.0,
      "curve": "linear",
      "exponent": 1.0,
      "center": 0.0,
      "amount": 0.8,
      "attackMs": 120,
      "releaseMs": 400
    }
  ],
  "triggers": [
    {
      "id": "kick",
      "on": "event.kick",
      "minStrength": 0.1,
      "refractoryMs": 90,
      "quantize": "none",
      "actions": [
        {
          "type": "envelope",
          "target": "kick",
          "amount": 1
        }
      ]
    },
    {
      "id": "snare",
      "on": "event.snare",
      "minStrength": 0.1,
      "refractoryMs": 70,
      "quantize": "none",
      "actions": [
        {
          "type": "envelope",
          "target": "snare",
          "amount": 1
        }
      ]
    },
    {
      "id": "hat",
      "on": "event.hat",
      "minStrength": 0.1,
      "refractoryMs": 45,
      "quantize": "none",
      "actions": [
        {
          "type": "envelope",
          "target": "hat",
          "amount": 1
        }
      ]
    },
    {
      "id": "user",
      "on": "event.userTrigger",
      "minStrength": 0,
      "refractoryMs": 50,
      "quantize": "none",
      "actions": [
        {
          "type": "envelope",
          "target": "kick",
          "amount": 1
        }
      ]
    },
    {
      "id": "palette",
      "on": "event.snare",
      "minStrength": 0.3,
      "refractoryMs": 1500,
      "quantize": "beat",
      "actions": [
        {
          "type": "palette-advance",
          "steps": 1
        }
      ]
    }
  ],
  "transition": {
    "type": "cut",
    "durationMs": 0,
    "quantize": "bar",
    "historyOnEnter": "reset",
    "retarget": "snapshot-current"
  },
  "post": {
    "bloom": {
      "enabled": true,
      "amount": 0.25,
      "threshold": 0.9,
      "levels": 5
    },
    "toneMap": "reinhard",
    "exposureEv": 0.3,
    "outputColorSpace": "srgb",
    "grain": 0.025,
    "vignette": 0.2
  },
  "performance": {
    "qualityTier": "medium",
    "sceneBudgetMs1080p": 3.0,
    "deterministicSeed": 707,
    "notes": "target, not measured"
  }
}
