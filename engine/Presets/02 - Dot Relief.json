{
  "schemaVersion": "2.0",
  "id": "dot-relief",
  "name": "Dot Relief",
  "description": "Abstract 3D forms rebuilt as a tilted relief of dots; accents lift the relief, a new form every 2 bars. In silence it flattens to a quiet dot grid.",
  "author": "VJ VST",
  "license": "project-internal",
  "engine": {
    "minimumVersion": "0.2.0",
    "shaderProfile": "isf-legacy",
    "workingColorSpace": "linear-srgb",
    "featureContract": "2.0"
  },
  "sourcePolicy": {
    "bass": "kick-or-mix",
    "mid": "snare-or-mix",
    "high": "hat-or-mix",
    "level": "mix"
  },
  "stages": [
    {
      "id": "dots",
      "kind": "generator",
      "shader": "Instrument/dot_relief.fs",
      "targetFormat": "rgba16f",
      "scale": 1.0,
      "inputs": {},
      "parameters": [
        {
          "name": "grid",
          "label": "Grid",
          "min": 40,
          "max": 200,
          "default": 90,
          "unit": "normalized",
          "cyclic": false
        },
        {
          "name": "depth",
          "label": "Depth",
          "min": 0,
          "max": 0.6,
          "default": 0.22,
          "unit": "normalized",
          "cyclic": false
        },
        {
          "name": "tilt",
          "label": "Tilt",
          "min": 0,
          "max": 0.8,
          "default": 0.35,
          "unit": "normalized",
          "cyclic": false
        },
        {
          "name": "dot_size",
          "label": "Dot Size",
          "min": 0.1,
          "max": 0.9,
          "default": 0.45,
          "unit": "normalized",
          "cyclic": false
        },
        {
          "name": "zoom",
          "label": "Zoom",
          "min": 0.7,
          "max": 2.6,
          "default": 1.15,
          "unit": "normalized",
          "cyclic": false
        },
        {
          "name": "sway",
          "label": "Sway",
          "min": 0.0,
          "max": 1.0,
          "default": 0.2,
          "unit": "normalized",
          "cyclic": false,
          "integrate": true
        },
        {
          "name": "surge",
          "label": "Surge",
          "min": 0,
          "max": 2,
          "default": 0,
          "unit": "normalized",
          "cyclic": false
        },
        {
          "name": "tint",
          "label": "Tint",
          "min": 0,
          "max": 1,
          "default": 0,
          "unit": "normalized",
          "cyclic": false
        },
        {
          "name": "hue",
          "label": "Hue",
          "min": 0,
          "max": 1,
          "default": 0.1,
          "unit": "normalized",
          "cyclic": true
        },
        {
          "name": "noise_floor",
          "label": "Noise Floor",
          "min": 0,
          "max": 1,
          "default": 0.12,
          "unit": "normalized",
          "cyclic": false
        }
      ],
      "sources": {
        "source": {
          "type": "images",
          "folder": "Images/Forms",
          "advance": "bar",
          "every": 2,
          "order": "random"
        }
      }
    }
  ],
  "macros": [
    {
      "id": "intensity",
      "slot": 0,
      "label": "dots",
      "default": 0.5
    },
    {
      "id": "speed",
      "slot": 1,
      "label": "Speed",
      "default": 0.5
    },
    {
      "id": "form",
      "slot": 2,
      "label": "tilt",
      "default": 0.5
    },
    {
      "id": "scale",
      "slot": 3,
      "label": "zoom",
      "default": 0.5
    },
    {
      "id": "react",
      "slot": 4,
      "label": "React",
      "default": 0.5
    },
    {
      "id": "erode",
      "slot": 5,
      "label": "dissolve",
      "default": 0.5
    },
    {
      "id": "glide",
      "slot": 6,
      "label": "Glide",
      "default": 0.25
    },
    {
      "id": "detail",
      "slot": 7,
      "label": "grid",
      "default": 0.5
    }
  ],
  "modulators": [
    {
      "id": "hit",
      "type": "ad",
      "attackMs": 0,
      "decayMs": 1300,
      "peak": 1,
      "retrigger": "max",
      "style": "hit"
    },
    {
      "id": "snare",
      "type": "ad",
      "attackMs": 2,
      "decayMs": 800,
      "peak": 1,
      "retrigger": "restart",
      "style": "snare"
    },
    {
      "id": "drop",
      "type": "ad",
      "attackMs": 0,
      "decayMs": 4000,
      "peak": 1,
      "retrigger": "max",
      "style": "drop"
    },
    {
      "id": "pulse",
      "type": "ad",
      "attackMs": 1,
      "decayMs": 80,
      "peak": 1,
      "retrigger": "restart"
    },
    {
      "id": "phrase",
      "type": "lfo",
      "shape": "sine",
      "periodBeats": 64,
      "phaseOffset": 0,
      "polarity": "bipolar"
    }
  ],
  "routes": [
    {
      "id": "macro-intensity-dots-dot_size",
      "source": "macro.intensity",
      "destination": "stage.dots.dot_size",
      "inputMin": 0.0,
      "inputMax": 1.0,
      "curve": "linear",
      "exponent": 1.0,
      "center": 0.5,
      "amount": 0.4,
      "attackMs": 60,
      "releaseMs": 60
    },
    {
      "id": "macro-form-dots-tilt",
      "source": "macro.form",
      "destination": "stage.dots.tilt",
      "inputMin": 0.0,
      "inputMax": 1.0,
      "curve": "linear",
      "exponent": 1.0,
      "center": 0.5,
      "amount": 0.8,
      "attackMs": 60,
      "releaseMs": 60
    },
    {
      "id": "macro-scale-dots-zoom",
      "source": "macro.scale",
      "destination": "stage.dots.zoom",
      "inputMin": 0.0,
      "inputMax": 1.0,
      "curve": "linear",
      "exponent": 1.0,
      "center": 0.5,
      "amount": -0.5,
      "attackMs": 60,
      "releaseMs": 60
    },
    {
      "id": "macro-erode-dots-noise_floor",
      "source": "macro.erode",
      "destination": "stage.dots.noise_floor",
      "inputMin": 0.0,
      "inputMax": 1.0,
      "curve": "linear",
      "exponent": 1.0,
      "center": 0.5,
      "amount": 0.8,
      "attackMs": 60,
      "releaseMs": 60
    },
    {
      "id": "macro-detail-dots-grid",
      "source": "macro.detail",
      "destination": "stage.dots.grid",
      "inputMin": 0.0,
      "inputMax": 1.0,
      "curve": "linear",
      "exponent": 1.0,
      "center": 0.5,
      "amount": 0.8,
      "attackMs": 60,
      "releaseMs": 60
    },
    {
      "id": "react-energy-dots-depth",
      "source": "react.energy",
      "destination": "stage.dots.depth",
      "inputMin": 0.0,
      "inputMax": 1.0,
      "curve": "linear",
      "exponent": 1.0,
      "center": 0.5,
      "amount": 0.6,
      "attackMs": 0,
      "releaseMs": 0
    },
    {
      "id": "env-hit-dots-surge",
      "source": "env.hit",
      "destination": "stage.dots.surge",
      "inputMin": 0.0,
      "inputMax": 1.0,
      "curve": "linear",
      "exponent": 1.0,
      "center": 0.0,
      "amount": 1.0,
      "attackMs": 0,
      "releaseMs": 0
    },
    {
      "id": "react-body-dots-dot_size",
      "source": "react.body",
      "destination": "stage.dots.dot_size",
      "inputMin": 0.0,
      "inputMax": 1.0,
      "curve": "linear",
      "exponent": 1.0,
      "center": 0.4,
      "amount": 0.3,
      "attackMs": 0,
      "releaseMs": 0
    },
    {
      "id": "react-tension-dots-tilt",
      "source": "react.tension",
      "destination": "stage.dots.tilt",
      "inputMin": 0.0,
      "inputMax": 1.0,
      "curve": "linear",
      "exponent": 1.0,
      "center": 0.0,
      "amount": 0.35,
      "attackMs": 0,
      "releaseMs": 0
    },
    {
      "id": "env-drop-dots-zoom",
      "source": "env.drop",
      "destination": "stage.dots.zoom",
      "inputMin": 0.0,
      "inputMax": 1.0,
      "curve": "linear",
      "exponent": 1.0,
      "center": 0.0,
      "amount": -0.25,
      "attackMs": 0,
      "releaseMs": 0
    },
    {
      "id": "react-air-dots-noise_floor",
      "source": "react.air",
      "destination": "stage.dots.noise_floor",
      "inputMin": 0.0,
      "inputMax": 1.0,
      "curve": "linear",
      "exponent": 1.0,
      "center": 0.3,
      "amount": 0.25,
      "attackMs": 0,
      "releaseMs": 0
    },
    {
      "id": "lfo-phrase-dots-tilt",
      "source": "lfo.phrase",
      "destination": "stage.dots.tilt",
      "inputMin": 0.0,
      "inputMax": 1.0,
      "curve": "linear",
      "exponent": 1.0,
      "center": 0.5,
      "amount": 0.15,
      "attackMs": 0,
      "releaseMs": 0
    }
  ],
  "triggers": [
    {
      "id": "accent",
      "on": "event.accent",
      "minStrength": 0,
      "refractoryMs": 0,
      "quantize": "none",
      "actions": [
        {
          "type": "envelope",
          "target": "hit",
          "amount": 1
        },
        {
          "type": "envelope",
          "target": "pulse",
          "amount": 1
        }
      ]
    },
    {
      "id": "tick",
      "on": "event.tick",
      "minStrength": 0,
      "refractoryMs": 0,
      "quantize": "none",
      "actions": [
        {
          "type": "envelope",
          "target": "hit",
          "amount": 1,
          "scale": "tick"
        }
      ]
    },
    {
      "id": "snare",
      "on": "event.snare",
      "minStrength": 0.1,
      "refractoryMs": 70,
      "quantize": "none",
      "actions": [
        {
          "type": "envelope",
          "target": "snare",
          "amount": 1,
          "scale": "snare"
        }
      ]
    },
    {
      "id": "drop",
      "on": "event.drop",
      "minStrength": 0,
      "refractoryMs": 0,
      "quantize": "none",
      "actions": [
        {
          "type": "envelope",
          "target": "drop",
          "amount": 1
        }
      ]
    }
  ],
  "transition": {
    "type": "cut",
    "durationMs": 0,
    "quantize": "beat",
    "historyOnEnter": "reset",
    "retarget": "snapshot-current"
  },
  "post": {
    "bloom": {
      "enabled": true,
      "amount": 0.22,
      "threshold": 0.9,
      "levels": 5
    },
    "toneMap": "reinhard",
    "exposureEv": 0.3,
    "outputColorSpace": "srgb",
    "grain": 0.0,
    "vignette": 0.25
  },
  "performance": {
    "qualityTier": "medium",
    "sceneBudgetMs1080p": 3.0,
    "deterministicSeed": 303,
    "notes": "target, not measured"
  }
}
