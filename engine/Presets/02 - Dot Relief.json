{
  "schemaVersion": "2.0",
  "id": "dot-relief",
  "name": "Dot Relief",
  "description": "Abstract 3D forms rebuilt as a tilted relief of dots; kicks lift the relief, a new form every 2 bars.",
  "author": "VJ VST",
  "license": "project-internal",
  "engine": {
    "minimumVersion": "0.2.0",
    "shaderProfile": "isf-legacy",
    "workingColorSpace": "linear-srgb",
    "featureContract": "2.0"
  },
  "sourcePolicy": {
    "bass": "kick-or-mix",
    "mid": "snare-or-mix",
    "high": "hat-or-mix",
    "level": "mix"
  },
  "stages": [
    {
      "id": "dots",
      "kind": "generator",
      "shader": "Instrument/dot_relief.fs",
      "targetFormat": "rgba16f",
      "scale": 1.0,
      "inputs": {},
      "parameters": [
        {
          "name": "grid",
          "label": "Grid",
          "min": 40,
          "max": 200,
          "default": 90,
          "unit": "normalized",
          "cyclic": false
        },
        {
          "name": "depth",
          "label": "Depth",
          "min": 0,
          "max": 0.6,
          "default": 0.22,
          "unit": "normalized",
          "cyclic": false
        },
        {
          "name": "tilt",
          "label": "Tilt",
          "min": 0,
          "max": 0.8,
          "default": 0.35,
          "unit": "normalized",
          "cyclic": false
        },
        {
          "name": "dot_size",
          "label": "Dot Size",
          "min": 0.1,
          "max": 0.9,
          "default": 0.45,
          "unit": "normalized",
          "cyclic": false
        },
        {
          "name": "zoom",
          "label": "Zoom",
          "min": 0.7,
          "max": 2.6,
          "default": 1.15,
          "unit": "normalized",
          "cyclic": false
        },
        {
          "name": "sway",
          "label": "Sway",
          "min": 0.0,
          "max": 1.0,
          "default": 0.2,
          "unit": "normalized",
          "cyclic": false,
          "integrate": true
        },
        {
          "name": "surge",
          "label": "Surge",
          "min": 0,
          "max": 1,
          "default": 0,
          "unit": "normalized",
          "cyclic": false
        },
        {
          "name": "tint",
          "label": "Tint",
          "min": 0,
          "max": 1,
          "default": 0,
          "unit": "normalized",
          "cyclic": false
        },
        {
          "name": "hue",
          "label": "Hue",
          "min": 0,
          "max": 1,
          "default": 0.1,
          "unit": "normalized",
          "cyclic": true
        },
        {
          "name": "noise_floor",
          "label": "Noise Floor",
          "min": 0,
          "max": 1,
          "default": 0.12,
          "unit": "normalized",
          "cyclic": false
        }
      ],
      "sources": {
        "source": {
          "type": "images",
          "folder": "Images/Forms",
          "advance": "bar",
          "every": 2,
          "order": "random"
        }
      }
    }
  ],
  "macros": [
    {
      "id": "intensity",
      "slot": 0,
      "label": "Intensity",
      "default": 0.5
    },
    {
      "id": "motion",
      "slot": 1,
      "label": "Motion",
      "default": 0.4
    },
    {
      "id": "color",
      "slot": 2,
      "label": "Color",
      "default": 0.5
    },
    {
      "id": "space",
      "slot": 3,
      "label": "Space",
      "default": 0.5
    },
    {
      "id": "impact",
      "slot": 4,
      "label": "Impact",
      "default": 0.5
    },
    {
      "id": "gravity",
      "slot": 5,
      "label": "Gravity",
      "default": 0.5
    },
    {
      "id": "viscosity",
      "slot": 6,
      "label": "Viscosity",
      "default": 0.5
    },
    {
      "id": "detail",
      "slot": 7,
      "label": "Detail",
      "default": 0.5
    }
  ],
  "modulators": [
    {
      "id": "kick",
      "type": "ad",
      "attackMs": 3,
      "decayMs": 180,
      "peak": 1,
      "retrigger": "max"
    },
    {
      "id": "snare",
      "type": "ad",
      "attackMs": 2,
      "decayMs": 140,
      "peak": 1,
      "retrigger": "restart"
    },
    {
      "id": "hat",
      "type": "ad",
      "attackMs": 1,
      "decayMs": 70,
      "peak": 1,
      "retrigger": "restart"
    },
    {
      "id": "swell",
      "type": "ad",
      "attackMs": 5,
      "decayMs": 900,
      "peak": 1,
      "retrigger": "max"
    },
    {
      "id": "drop",
      "type": "ad",
      "attackMs": 1,
      "decayMs": 60,
      "peak": 1,
      "retrigger": "restart"
    },
    {
      "id": "drift",
      "type": "lfo",
      "shape": "sine",
      "periodBeats": 16,
      "phaseOffset": 0,
      "polarity": "bipolar"
    }
  ],
  "routes": [
    {
      "id": "macro-intensity-dots-dot_size",
      "source": "macro.intensity",
      "destination": "stage.dots.dot_size",
      "inputMin": 0.0,
      "inputMax": 1.0,
      "curve": "linear",
      "exponent": 1.0,
      "center": 0.5,
      "amount": 0.4,
      "attackMs": 20,
      "releaseMs": 180
    },
    {
      "id": "macro-intensity-dots-depth",
      "source": "macro.intensity",
      "destination": "stage.dots.depth",
      "inputMin": 0.0,
      "inputMax": 1.0,
      "curve": "linear",
      "exponent": 1.0,
      "center": 0.5,
      "amount": 0.4,
      "attackMs": 20,
      "releaseMs": 180
    },
    {
      "id": "macro-motion-dots-sway",
      "source": "macro.motion",
      "destination": "stage.dots.sway",
      "inputMin": 0.0,
      "inputMax": 1.0,
      "curve": "linear",
      "exponent": 1.0,
      "center": 0.4,
      "amount": 0.9,
      "attackMs": 20,
      "releaseMs": 180
    },
    {
      "id": "macro-color-dots-noise_floor",
      "source": "macro.color",
      "destination": "stage.dots.noise_floor",
      "inputMin": 0.0,
      "inputMax": 1.0,
      "curve": "linear",
      "exponent": 1.0,
      "center": 0.5,
      "amount": 0.6,
      "attackMs": 20,
      "releaseMs": 180
    },
    {
      "id": "macro-space-dots-zoom",
      "source": "macro.space",
      "destination": "stage.dots.zoom",
      "inputMin": 0.0,
      "inputMax": 1.0,
      "curve": "linear",
      "exponent": 1.0,
      "center": 0.5,
      "amount": -0.4,
      "attackMs": 20,
      "releaseMs": 180
    },
    {
      "id": "macro-detail-dots-grid",
      "source": "macro.detail",
      "destination": "stage.dots.grid",
      "inputMin": 0.0,
      "inputMax": 1.0,
      "curve": "linear",
      "exponent": 1.0,
      "center": 0.5,
      "amount": 0.8,
      "attackMs": 20,
      "releaseMs": 180
    },
    {
      "id": "macro-gravity-dots-tilt",
      "source": "macro.gravity",
      "destination": "stage.dots.tilt",
      "inputMin": 0.0,
      "inputMax": 1.0,
      "curve": "linear",
      "exponent": 1.0,
      "center": 0.5,
      "amount": 0.8,
      "attackMs": 20,
      "releaseMs": 180
    },
    {
      "id": "macro-viscosity-dots-sway",
      "source": "macro.viscosity",
      "destination": "stage.dots.sway",
      "inputMin": 0.0,
      "inputMax": 1.0,
      "curve": "linear",
      "exponent": 1.0,
      "center": 0.5,
      "amount": -0.4,
      "attackMs": 20,
      "releaseMs": 180
    },
    {
      "id": "env-kick-dots-surge",
      "source": "env.kick",
      "destination": "stage.dots.surge",
      "inputMin": 0.0,
      "inputMax": 1.0,
      "curve": "linear",
      "exponent": 1.0,
      "center": 0.0,
      "amount": 1.0,
      "attackMs": 0,
      "releaseMs": 0,
      "scaleBy": "macro.impact"
    },
    {
      "id": "env-swell-dots-depth",
      "source": "env.swell",
      "destination": "stage.dots.depth",
      "inputMin": 0.0,
      "inputMax": 1.0,
      "curve": "linear",
      "exponent": 1.0,
      "center": 0.0,
      "amount": 0.3,
      "attackMs": 0,
      "releaseMs": 0,
      "scaleBy": "macro.impact"
    },
    {
      "id": "audio-bass-activity-dots-depth",
      "source": "audio.bass.activity",
      "destination": "stage.dots.depth",
      "inputMin": 0.0,
      "inputMax": 1.0,
      "curve": "linear",
      "exponent": 1.0,
      "center": 0.0,
      "amount": 0.2,
      "attackMs": 30,
      "releaseMs": 220
    },
    {
      "id": "audio-high-activity-dots-noise_floor",
      "source": "audio.high.activity",
      "destination": "stage.dots.noise_floor",
      "inputMin": 0.0,
      "inputMax": 1.0,
      "curve": "linear",
      "exponent": 1.0,
      "center": 0.0,
      "amount": 0.3,
      "attackMs": 30,
      "releaseMs": 220
    }
  ],
  "triggers": [
    {
      "id": "kick",
      "on": "event.kick",
      "minStrength": 0.1,
      "refractoryMs": 90,
      "quantize": "none",
      "actions": [
        {
          "type": "envelope",
          "target": "kick",
          "amount": 1
        },
        {
          "type": "envelope",
          "target": "swell",
          "amount": 1
        },
        {
          "type": "envelope",
          "target": "drop",
          "amount": 1
        },
        {
          "type": "reseed"
        }
      ]
    },
    {
      "id": "snare",
      "on": "event.snare",
      "minStrength": 0.1,
      "refractoryMs": 70,
      "quantize": "none",
      "actions": [
        {
          "type": "envelope",
          "target": "snare",
          "amount": 1
        }
      ]
    },
    {
      "id": "hat",
      "on": "event.hat",
      "minStrength": 0.1,
      "refractoryMs": 45,
      "quantize": "none",
      "actions": [
        {
          "type": "envelope",
          "target": "hat",
          "amount": 1
        }
      ]
    },
    {
      "id": "user",
      "on": "event.userTrigger",
      "minStrength": 0,
      "refractoryMs": 50,
      "quantize": "none",
      "actions": [
        {
          "type": "envelope",
          "target": "kick",
          "amount": 1
        },
        {
          "type": "envelope",
          "target": "swell",
          "amount": 1
        },
        {
          "type": "envelope",
          "target": "drop",
          "amount": 1
        },
        {
          "type": "reseed"
        }
      ]
    }
  ],
  "transition": {
    "type": "cut",
    "durationMs": 0,
    "quantize": "bar",
    "historyOnEnter": "reset",
    "retarget": "snapshot-current"
  },
  "post": {
    "bloom": {
      "enabled": true,
      "amount": 0.22,
      "threshold": 0.9,
      "levels": 5
    },
    "toneMap": "reinhard",
    "exposureEv": 0.3,
    "outputColorSpace": "srgb",
    "grain": 0.0,
    "vignette": 0.25
  },
  "performance": {
    "qualityTier": "medium",
    "sceneBudgetMs1080p": 3.0,
    "deterministicSeed": 303,
    "notes": "target, not measured"
  }
}
