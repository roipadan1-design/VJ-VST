{
  "schemaVersion": "2.0",
  "id": "mask-kaleido",
  "name": "Mask Kaleido",
  "description": "Masks tiled and mirrored over a wavy duotone field, solarised; snares turn the tiles.",
  "author": "VJ VST",
  "license": "project-internal",
  "engine": {
    "minimumVersion": "0.2.0",
    "shaderProfile": "isf-legacy",
    "workingColorSpace": "linear-srgb",
    "featureContract": "2.0"
  },
  "sourcePolicy": {
    "bass": "kick-or-mix",
    "mid": "snare-or-mix",
    "high": "hat-or-mix",
    "level": "mix"
  },
  "stages": [
    {
      "id": "kaleido",
      "kind": "generator",
      "shader": "Instrument/mask_kaleido.fs",
      "targetFormat": "rgba16f",
      "scale": 1.0,
      "inputs": {},
      "parameters": [
        {
          "name": "tiles",
          "label": "Tiles",
          "min": 1,
          "max": 8,
          "default": 3,
          "unit": "normalized",
          "cyclic": false
        },
        {
          "name": "wave",
          "label": "Wave",
          "min": 0,
          "max": 1.5,
          "default": 0.35,
          "unit": "normalized",
          "cyclic": false
        },
        {
          "name": "flow",
          "label": "Flow",
          "min": 0.0,
          "max": 1.2,
          "default": 0.2,
          "unit": "normalized",
          "cyclic": false,
          "integrate": true
        },
        {
          "name": "solarize",
          "label": "Solarize",
          "min": 0,
          "max": 1,
          "default": 0.5,
          "unit": "normalized",
          "cyclic": false
        },
        {
          "name": "turn",
          "label": "Turn",
          "min": 0,
          "max": 1,
          "default": 0,
          "unit": "normalized",
          "cyclic": false
        },
        {
          "name": "hue",
          "label": "Hue",
          "min": 0,
          "max": 1,
          "default": 0.55,
          "unit": "normalized",
          "cyclic": true
        },
        {
          "name": "fill",
          "label": "Fill",
          "min": 0.4,
          "max": 1.4,
          "default": 0.85,
          "unit": "normalized",
          "cyclic": false
        },
        {
          "name": "emission",
          "label": "Emission",
          "min": 0.3,
          "max": 3.5,
          "default": 1.1,
          "unit": "normalized",
          "cyclic": false
        }
      ],
      "sources": {
        "source": {
          "type": "images",
          "folder": "Images/Masks",
          "advance": "bar",
          "every": 2,
          "order": "random"
        }
      }
    }
  ],
  "macros": [
    {
      "id": "intensity",
      "slot": 0,
      "label": "Intensity",
      "default": 0.5
    },
    {
      "id": "motion",
      "slot": 1,
      "label": "Motion",
      "default": 0.4
    },
    {
      "id": "color",
      "slot": 2,
      "label": "Color",
      "default": 0.5
    },
    {
      "id": "space",
      "slot": 3,
      "label": "Space",
      "default": 0.5
    }
  ],
  "modulators": [
    {
      "id": "kick",
      "type": "ad",
      "attackMs": 3,
      "decayMs": 180,
      "peak": 1,
      "retrigger": "max"
    },
    {
      "id": "snare",
      "type": "ad",
      "attackMs": 2,
      "decayMs": 140,
      "peak": 1,
      "retrigger": "restart"
    },
    {
      "id": "hat",
      "type": "ad",
      "attackMs": 1,
      "decayMs": 70,
      "peak": 1,
      "retrigger": "restart"
    },
    {
      "id": "drift",
      "type": "lfo",
      "shape": "sine",
      "periodBeats": 16,
      "phaseOffset": 0,
      "polarity": "bipolar"
    }
  ],
  "routes": [
    {
      "id": "macro-intensity-kaleido-solarize",
      "source": "macro.intensity",
      "destination": "stage.kaleido.solarize",
      "inputMin": 0.0,
      "inputMax": 1.0,
      "curve": "linear",
      "exponent": 1.0,
      "center": 0.5,
      "amount": 0.7,
      "attackMs": 20,
      "releaseMs": 180
    },
    {
      "id": "macro-intensity-kaleido-emission",
      "source": "macro.intensity",
      "destination": "stage.kaleido.emission",
      "inputMin": 0.0,
      "inputMax": 1.0,
      "curve": "linear",
      "exponent": 1.0,
      "center": 0.5,
      "amount": 0.3,
      "attackMs": 20,
      "releaseMs": 180
    },
    {
      "id": "macro-motion-kaleido-flow",
      "source": "macro.motion",
      "destination": "stage.kaleido.flow",
      "inputMin": 0.0,
      "inputMax": 1.0,
      "curve": "linear",
      "exponent": 1.0,
      "center": 0.4,
      "amount": 0.9,
      "attackMs": 20,
      "releaseMs": 180
    },
    {
      "id": "macro-color-kaleido-hue",
      "source": "macro.color",
      "destination": "stage.kaleido.hue",
      "inputMin": 0.0,
      "inputMax": 1.0,
      "curve": "linear",
      "exponent": 1.0,
      "center": 0.5,
      "amount": 1.0,
      "attackMs": 20,
      "releaseMs": 180
    },
    {
      "id": "macro-space-kaleido-tiles",
      "source": "macro.space",
      "destination": "stage.kaleido.tiles",
      "inputMin": 0.0,
      "inputMax": 1.0,
      "curve": "linear",
      "exponent": 1.0,
      "center": 0.5,
      "amount": 0.8,
      "attackMs": 20,
      "releaseMs": 180
    },
    {
      "id": "env-snare-kaleido-turn",
      "source": "env.snare",
      "destination": "stage.kaleido.turn",
      "inputMin": 0.0,
      "inputMax": 1.0,
      "curve": "linear",
      "exponent": 1.0,
      "center": 0.0,
      "amount": 1.0,
      "attackMs": 0,
      "releaseMs": 0
    },
    {
      "id": "env-kick-kaleido-fill",
      "source": "env.kick",
      "destination": "stage.kaleido.fill",
      "inputMin": 0.0,
      "inputMax": 1.0,
      "curve": "linear",
      "exponent": 1.0,
      "center": 0.0,
      "amount": 0.2,
      "attackMs": 0,
      "releaseMs": 0
    },
    {
      "id": "audio-bass-activity-kaleido-wave",
      "source": "audio.bass.activity",
      "destination": "stage.kaleido.wave",
      "inputMin": 0.0,
      "inputMax": 1.0,
      "curve": "linear",
      "exponent": 1.0,
      "center": 0.0,
      "amount": 0.3,
      "attackMs": 30,
      "releaseMs": 220
    }
  ],
  "triggers": [
    {
      "id": "kick",
      "on": "event.kick",
      "minStrength": 0.1,
      "refractoryMs": 90,
      "quantize": "none",
      "actions": [
        {
          "type": "envelope",
          "target": "kick",
          "amount": 1
        }
      ]
    },
    {
      "id": "snare",
      "on": "event.snare",
      "minStrength": 0.1,
      "refractoryMs": 70,
      "quantize": "none",
      "actions": [
        {
          "type": "envelope",
          "target": "snare",
          "amount": 1
        }
      ]
    },
    {
      "id": "hat",
      "on": "event.hat",
      "minStrength": 0.1,
      "refractoryMs": 45,
      "quantize": "none",
      "actions": [
        {
          "type": "envelope",
          "target": "hat",
          "amount": 1
        }
      ]
    },
    {
      "id": "user",
      "on": "event.userTrigger",
      "minStrength": 0,
      "refractoryMs": 50,
      "quantize": "none",
      "actions": [
        {
          "type": "envelope",
          "target": "kick",
          "amount": 1
        }
      ]
    }
  ],
  "transition": {
    "type": "cut",
    "durationMs": 0,
    "quantize": "bar",
    "historyOnEnter": "reset",
    "retarget": "snapshot-current"
  },
  "post": {
    "bloom": {
      "enabled": true,
      "amount": 0.25,
      "threshold": 0.9,
      "levels": 5
    },
    "toneMap": "reinhard",
    "exposureEv": 0.3,
    "outputColorSpace": "srgb",
    "grain": 0.025,
    "vignette": 0.2
  },
  "performance": {
    "qualityTier": "medium",
    "sceneBudgetMs1080p": 3.0,
    "deterministicSeed": 1001,
    "notes": "target, not measured"
  }
}
